diff --git a/include/rtreticulum/identity.h b/include/rtreticulum/identity.h
index 755f68e..a8b760b 100644
--- a/include/rtreticulum/identity.h
+++ b/include/rtreticulum/identity.h
@@ -41,6 +41,13 @@ namespace RNS {
 
         Identity& operator=(const Identity& other) { _object = other._object; return *this; }
         explicit operator bool() const { return _object != nullptr; }
+        /* True when this identity actually holds usable key material (either
+         * generated or loaded), as opposed to a keyless placeholder such as
+         * Identity(false). operator bool() is true for a keyless placeholder
+         * (the object exists), which is why Destination must use has_key() to
+         * decide whether appending the identity to a name/hash is valid or
+         * whether a PLAIN destination may not hold it (issue #133 item 2). */
+        bool has_key() const { return _object && _object->_pub && _object->_sig_pub; }
         bool operator<(const Identity& other) const { return _object.get() < other._object.get(); }
 
         void createKeys();
