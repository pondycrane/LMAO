+bool Transport::process_path_request(const Packet& packet, const Interface& iface) {
+    /* Called only from inbound() which already holds _mutex.
+     *
+     * Mirrors RNS Transport.path_request_handler + the local-destination
+     * branch of Transport.path_request(): a DATA packet to the PLAIN
+     * "rnstransport.path.request" destination whose payload is
+     *   target_destination_hash(16) [+ transport_id(16)] + tag(<=16)
+     * asks who can reach *target*. If the target is a destination local to
+     * this node (IN/SINGLE), answer by announcing it with the PATH_RESPONSE
+     * context byte set (0x0B) — the requester's normal announce handling
+     * then populates its path table from the reply (on-demand discovery, so
+     * a node no longer has to wait for the periodic announce). */
+    constexpr size_t HL = Type::Reticulum::DESTINATION_LENGTH;   // 16
+    const Bytes& d = packet.data();
+    if (d.size() < HL) return false;
+    const Bytes target = d.left(HL);
+
+    /* Tag follows the transport instance ID when one is present; the leaf
+     * form (no transport node) is target(16) + tag(16). */
+    Bytes tag;
+    if (d.size() > 2 * HL) tag = d.mid(2 * HL, HL);
+    else if (d.size() > HL) tag = d.mid(HL);
+    else return false;
+    if (tag.size() > HL) tag = tag.left(HL);
+    if (tag.empty()) return false;
+
+    Bytes unique = target; unique.append(tag);
+    if (std::find(_seen_path_requests.begin(), _seen_path_requests.end(), unique) !=
+        _seen_path_requests.end())
+        return false;   // duplicate request (same target + tag)
+    _seen_path_requests.push_back(unique);
+    if (_seen_path_requests.size() > 32) _seen_path_requests.erase(_seen_path_requests.begin());
+
+    auto it = _destinations.find(target);
+    if (it == _destinations.end() || it->second.direction() != Type::Destination::IN)
+        return false;   // not a local IN destination — nothing to answer with
+
+    Bytes raw = it->second.announce(Bytes(), /*send=*/false);
+    if (raw.empty()) return false;
+
+    /* Stamp the PATH_RESPONSE context byte so peers recognise the reply as a
+     * path response (RNS does the same when answering path requests). Context
+     * lives at 2 + DEST_LEN for HEADER_1, 2 + 2*DEST_LEN for HEADER_2. */
+    constexpr size_t DST = Type::Reticulum::DESTINATION_LENGTH;
+    const bool hdr2 = (raw.data()[0] & 0x40) != 0;
+    const size_t off = 2 + (hdr2 ? 2 * DST : DST);
+    if (raw.size() > off) raw[off] = static_cast<uint8_t>(Type::Packet::PATH_RESPONSE);
+
+    DEBUGF("Transport: path request answered for %s",
+           target.toHex().substr(0, 16).c_str());
+    broadcast(raw);
+    return true;
+}
