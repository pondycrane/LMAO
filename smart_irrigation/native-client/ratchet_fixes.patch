+
+Bytes Identity::get_ratchet(const Bytes& destination_hash) {
+    auto it = _known_ratchets.find(destination_hash);
+    return it == _known_ratchets.end() ? Bytes{Bytes::NONE} : it->second;
+}
+
+void Identity::remember_ratchet(const Bytes& destination_hash, const Bytes& ratchet_pub) {
+    if (ratchet_pub.size() != Type::Identity::RATCHETSIZE / 8) return;
+    _known_ratchets[destination_hash] = ratchet_pub;
+}
+
+void Identity::clear_ratchets() {
+    _known_ratchets.clear();
+}
 
