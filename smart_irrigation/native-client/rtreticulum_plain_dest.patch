diff --git a/include/rtreticulum/identity.h b/include/rtreticulum/identity.h
index 755f68e..a8b760b 100644
--- a/include/rtreticulum/identity.h
+++ b/include/rtreticulum/identity.h
@@ -41,6 +41,13 @@ namespace RNS {
 
         Identity& operator=(const Identity& other) { _object = other._object; return *this; }
         explicit operator bool() const { return _object != nullptr; }
+        /* True when this identity actually holds usable key material (either
+         * generated or loaded), as opposed to a keyless placeholder such as
+         * Identity(false). operator bool() is true for a keyless placeholder
+         * (the object exists), which is why Destination must use has_key() to
+         * decide whether appending the identity to a name/hash is valid or
+         * whether a PLAIN destination may not hold it (issue #133 item 2). */
+        bool has_key() const { return _object && _object->_pub && _object->_sig_pub; }
         bool operator<(const Identity& other) const { return _object.get() < other._object.get(); }
 
         void createKeys();
diff --git a/src/destination.cpp b/src/destination.cpp
index 5430506..fccfc72 100644
--- a/src/destination.cpp
+++ b/src/destination.cpp
@@ -25,7 +25,7 @@ Destination::Destination(const Identity& identity, TD::directions direction, TD:
         _object->_identity = Identity();
         fullaspects += "." + _object->_identity.hexhash();
     }
-    if (_object->_identity && type == TD::PLAIN)
+    if (_object->_identity.has_key() && type == TD::PLAIN)
         throw std::invalid_argument("PLAIN destination cannot hold an identity");
 
     _object->_name      = expand_name(_object->_identity, app_name, fullaspects.c_str());
@@ -39,7 +39,7 @@ Destination::Destination(const Identity& identity, TD::directions direction, TD:
     : _object(std::make_shared<Object>(identity)) {
     _object->_type      = type;
     _object->_direction = direction;
-    if (_object->_identity && type == TD::PLAIN)
+    if (_object->_identity.has_key() && type == TD::PLAIN)
         throw std::invalid_argument("PLAIN destination cannot hold an identity");
     _object->_hash      = precomputed_hash;
     _object->_hexhash   = _object->_hash.toHex();
@@ -51,13 +51,13 @@ std::string Destination::expand_name(const Identity& identity, const char* app_n
         throw std::invalid_argument("Dots can't be used in app names");
     std::string name(app_name);
     if (aspects && aspects[0]) name += std::string(".") + aspects;
-    if (identity)              name += "." + identity.hexhash();
+    if (identity.has_key())              name += "." + identity.hexhash();
     return name;
 }
 
 Bytes Destination::hash(const Identity& identity, const char* app_name, const char* aspects) {
     Bytes addr_material = name_hash(app_name, aspects);
-    if (identity) addr_material << identity.hash();
+    if (identity.has_key()) addr_material << identity.hash();
