# LMAO socket humidifier controller — Docker image
#
# The in-cluster controller (k8s/humidifier.yaml): reads the room's humidity
# from the Atom Socket's own ENV III (GET /status) — or, when that sample is
# missing/stale, from the LMAO server's air series over Reticulum TCP — applies
# the dew-point law, then PUBLISHES the decision to the server's directive
# relay (lma_core/humidifier_api.py, :8082).  The socket polls that relay from
# its own outbound path; the direct push to the socket's leased HTTP API stays
# as HF_PUSH=1 until the socket runs the pull firmware.
#
# Build + release + deploy in one step (the sanctioned path):
#   bazel run //lmao_socket_humidifier:deploy
#
# Build only:
#   docker build -f Dockerfile.humidifier -t lmao-humidifier .
#
# Run (host network, so Reticulum TCP to the server and the LAN socket work):
#   docker run --rm -it --network host \
#     -e LMAO_SERVER_HOST=tp4 -e HF_SOCKET=humidifier.local \
#     -e HF_API_TOKEN=... -e HF_STATE_FILE=/state/state.json \
#     -v /tmp/hf-state:/state lmao-humidifier
#
# The whole dependency set is pure Python with aarch64 wheels (rns, lxmf,
# protobuf), so there is no compiler in the image: 253 MB measured (the first
# version copied the 124 MB ESP-IDF firmware tree and weighed 417 MB, and a Pi
# pulling it made the first rollout time out — .dockerignore now excludes it).
#
# rns/lxmf are pinned to match lmao_server/requirements_lock.txt: unpinned
# installs drifted the server image off the Bazel-tested versions and broke the
# LXMF ACK path (issue #70).

FROM python:3.12-slim

WORKDIR /app

# mDNS fallback.  HF_SOCKET's second entry is the socket's mDNS name, but
# python:3.12-slim has no mDNS resolver and its nsswitch.conf is
# "hosts: files dns" — so the fallback never resolved.  On 2026-11-21 the
# bedroom socket's DHCP lease moved .22 -> .21, the pinned address went dead,
# and the controller drove it for 7 h with "Name or service not known" on the
# fallback.  libnss-mdns + mdns4_minimal makes the fallback real; hostNetwork
# gives the pod the host's LAN interface, so multicast reaches the socket.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libnss-mdns \
 && rm -rf /var/lib/apt/lists/* \
 && sed -i 's/^hosts:.*/hosts: files mdns4_minimal [NOTFOUND=return] dns/' /etc/nsswitch.conf \
 && grep -q '^hosts:.*mdns4_minimal' /etc/nsswitch.conf

RUN pip install --no-cache-dir \
    protobuf==6.33.6 \
    rns==1.3.5 \
    lxmf==1.0.1

# Only the modules this controller actually imports.  The protobuf stub
# (proto/lma_messages_pb2.py) is tracked source, generated by //proto, so it is
# copied rather than regenerated — no protoc, no grpcio-tools.
COPY lma_core/ lma_core/
COPY proto/ proto/
COPY robodog_home_client/ robodog_home_client/
COPY lmao_socket_humidifier/ lmao_socket_humidifier/

# robodog_home_client/client.py does `import config` (its own module), so its
# directory is on the path as well as the repo root.
ENV PYTHONPATH="/app:/app/robodog_home_client"
ENV PYTHONUNBUFFERED=1

# Config comes from the environment (k8s ConfigMap/Secret): HF_SENSOR_SOURCE,
# LMAO_ENV_NODE, LMAO_SERVER_HOST/PORT, HF_SOCKET, HF_API_TOKEN, HF_STATE_FILE,
# HF_IDENTITY_DIR.  Nothing is baked in.
CMD ["python", "lmao_socket_humidifier/controller.py"]
