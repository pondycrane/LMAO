# Humidifier Atom Socket — M5Stack Atom Lite (ESP32-PICO-D4, 4 MB flash).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console on UART0 (the Atom's USB-C is a CP210x/FTDI bridge, not USB-Serial-
# JTAG), so `idf.py monitor` / the flash script read /dev/ttyUSB*.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# HLW8032 RX is UART2; the driver + HTTP server + mDNS fit internal RAM.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MDNS_MAX_SERVICES=4

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
