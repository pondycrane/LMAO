<!-- RoboDog family-calendar screen: 300x400 portrait, 1-bit black-on-white.

     Subjects (created and registered from C in calendar_ui.cpp):
       header_text   (string)  - header band line
       status_text   (string)  - right-aligned status ("OFFLINE" or "")
       row0..5_title   (string)
       row0..5_time    (string)
       row0..5_present (int 0/1) - row container hidden while 0
       row0..5_pic     (int 0/1) - pic placeholder hidden while 0

     Fonts lv_font_montserrat_14 / lv_font_montserrat_20 are registered from
     C (calendar_ui.cpp); the scaffold enables them via Kconfig. -->
<component>
    <view extends="lv_obj"
          width="300" height="400" x="0" y="0" scrollable="false"
          style_layout="flex" style_flex_flow="column"
          style_pad_all="4" style_pad_row="0"
          style_radius="0" style_border_width="0"
          style_bg_color="0xffffff" style_bg_opa="100%"
          style_text_color="0x000000">

        <!-- Header band: title/date left, status right -->
        <lv_obj width="100%" height="30" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_radius="0" style_border_width="0"
                style_bg_opa="0%">
            <lv_label bind_text="header_text"
                      style_text_font="lv_font_montserrat_14"
                      style_text_color="0x000000"/>
            <lv_label bind_text="status_text"
                      style_text_font="lv_font_montserrat_14"
                      style_text_color="0x000000"/>
        </lv_obj>

        <!-- 1px separator line -->
        <lv_obj width="100%" height="1" scrollable="false"
                style_pad_all="0" style_radius="0" style_border_width="0"
                style_bg_color="0x000000" style_bg_opa="100%"/>

        <!-- Event row 0 -->
        <lv_obj width="100%" height="58" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_pad_column="8"
                style_radius="0" style_border_width="0" style_bg_opa="0%">
            <lv_obj-bind_flag_if_eq subject="row0_present" flag="hidden" ref_value="0"/>
            <lv_obj style_flex_grow="1" height="content" scrollable="false"
                    style_layout="flex" style_flex_flow="column" style_pad_row="6"
                    style_pad_all="0" style_radius="0" style_border_width="0"
                    style_bg_opa="0%">
                <lv_label bind_text="row0_title" width="100%" long_mode="dots"
                          style_text_font="lv_font_montserrat_20"
                          style_text_color="0x000000"/>
                <lv_label bind_text="row0_time" width="100%" long_mode="clip"
                          style_text_font="lv_font_montserrat_14"
                          style_text_color="0x000000"/>
            </lv_obj>
            <lv_image width="32" height="32" scrollable="false"
                      style_pad_all="0" style_radius="0"
                      style_border_width="0" style_bg_opa="0%">
                <lv_image-bind_flag_if_eq subject="row0_pic" flag="hidden" ref_value="0"/>
            </lv_image>
        </lv_obj>

        <!-- Event row 1 -->
        <lv_obj width="100%" height="58" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_pad_column="8"
                style_radius="0" style_border_width="0" style_bg_opa="0%">
            <lv_obj-bind_flag_if_eq subject="row1_present" flag="hidden" ref_value="0"/>
            <lv_obj style_flex_grow="1" height="content" scrollable="false"
                    style_layout="flex" style_flex_flow="column" style_pad_row="6"
                    style_pad_all="0" style_radius="0" style_border_width="0"
                    style_bg_opa="0%">
                <lv_label bind_text="row1_title" width="100%" long_mode="dots"
                          style_text_font="lv_font_montserrat_20"
                          style_text_color="0x000000"/>
                <lv_label bind_text="row1_time" width="100%" long_mode="clip"
                          style_text_font="lv_font_montserrat_14"
                          style_text_color="0x000000"/>
            </lv_obj>
            <lv_image width="32" height="32" scrollable="false"
                      style_pad_all="0" style_radius="0"
                      style_border_width="0" style_bg_opa="0%">
                <lv_image-bind_flag_if_eq subject="row1_pic" flag="hidden" ref_value="0"/>
            </lv_image>
        </lv_obj>

        <!-- Event row 2 -->
        <lv_obj width="100%" height="58" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_pad_column="8"
                style_radius="0" style_border_width="0" style_bg_opa="0%">
            <lv_obj-bind_flag_if_eq subject="row2_present" flag="hidden" ref_value="0"/>
            <lv_obj style_flex_grow="1" height="content" scrollable="false"
                    style_layout="flex" style_flex_flow="column" style_pad_row="6"
                    style_pad_all="0" style_radius="0" style_border_width="0"
                    style_bg_opa="0%">
                <lv_label bind_text="row2_title" width="100%" long_mode="dots"
                          style_text_font="lv_font_montserrat_20"
                          style_text_color="0x000000"/>
                <lv_label bind_text="row2_time" width="100%" long_mode="clip"
                          style_text_font="lv_font_montserrat_14"
                          style_text_color="0x000000"/>
            </lv_obj>
            <lv_image width="32" height="32" scrollable="false"
                      style_pad_all="0" style_radius="0"
                      style_border_width="0" style_bg_opa="0%">
                <lv_image-bind_flag_if_eq subject="row2_pic" flag="hidden" ref_value="0"/>
            </lv_image>
        </lv_obj>

        <!-- Event row 3 -->
        <lv_obj width="100%" height="58" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_pad_column="8"
                style_radius="0" style_border_width="0" style_bg_opa="0%">
            <lv_obj-bind_flag_if_eq subject="row3_present" flag="hidden" ref_value="0"/>
            <lv_obj style_flex_grow="1" height="content" scrollable="false"
                    style_layout="flex" style_flex_flow="column" style_pad_row="6"
                    style_pad_all="0" style_radius="0" style_border_width="0"
                    style_bg_opa="0%">
                <lv_label bind_text="row3_title" width="100%" long_mode="dots"
                          style_text_font="lv_font_montserrat_20"
                          style_text_color="0x000000"/>
                <lv_label bind_text="row3_time" width="100%" long_mode="clip"
                          style_text_font="lv_font_montserrat_14"
                          style_text_color="0x000000"/>
            </lv_obj>
            <lv_image width="32" height="32" scrollable="false"
                      style_pad_all="0" style_radius="0"
                      style_border_width="0" style_bg_opa="0%">
                <lv_image-bind_flag_if_eq subject="row3_pic" flag="hidden" ref_value="0"/>
            </lv_image>
        </lv_obj>

        <!-- Event row 4 -->
        <lv_obj width="100%" height="58" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_pad_column="8"
                style_radius="0" style_border_width="0" style_bg_opa="0%">
            <lv_obj-bind_flag_if_eq subject="row4_present" flag="hidden" ref_value="0"/>
            <lv_obj style_flex_grow="1" height="content" scrollable="false"
                    style_layout="flex" style_flex_flow="column" style_pad_row="6"
                    style_pad_all="0" style_radius="0" style_border_width="0"
                    style_bg_opa="0%">
                <lv_label bind_text="row4_title" width="100%" long_mode="dots"
                          style_text_font="lv_font_montserrat_20"
                          style_text_color="0x000000"/>
                <lv_label bind_text="row4_time" width="100%" long_mode="clip"
                          style_text_font="lv_font_montserrat_14"
                          style_text_color="0x000000"/>
            </lv_obj>
            <lv_image width="32" height="32" scrollable="false"
                      style_pad_all="0" style_radius="0"
                      style_border_width="0" style_bg_opa="0%">
                <lv_image-bind_flag_if_eq subject="row4_pic" flag="hidden" ref_value="0"/>
            </lv_image>
        </lv_obj>

        <!-- Event row 5 -->
        <lv_obj width="100%" height="58" scrollable="false"
                style_layout="flex" style_flex_flow="row"
                style_flex_main_place="space_between"
                style_flex_cross_place="center"
                style_pad_all="0" style_pad_column="8"
                style_radius="0" style_border_width="0" style_bg_opa="0%">
            <lv_obj-bind_flag_if_eq subject="row5_present" flag="hidden" ref_value="0"/>
            <lv_obj style_flex_grow="1" height="content" scrollable="false"
                    style_layout="flex" style_flex_flow="column" style_pad_row="6"
                    style_pad_all="0" style_radius="0" style_border_width="0"
                    style_bg_opa="0%">
                <lv_label bind_text="row5_title" width="100%" long_mode="dots"
                          style_text_font="lv_font_montserrat_20"
                          style_text_color="0x000000"/>
                <lv_label bind_text="row5_time" width="100%" long_mode="clip"
                          style_text_font="lv_font_montserrat_14"
                          style_text_color="0x000000"/>
            </lv_obj>
            <lv_image width="32" height="32" scrollable="false"
                      style_pad_all="0" style_radius="0"
                      style_border_width="0" style_bg_opa="0%">
                <lv_image-bind_flag_if_eq subject="row5_pic" flag="hidden" ref_value="0"/>
            </lv_image>
        </lv_obj>
    </view>
</component>
