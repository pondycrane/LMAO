# ESP-IDF defaults for the RoboDog native client (Waveshare ESP32-S3 RLCD-4.2,
# ESP32-S3 N16R8: 16MB flash + 8MB octal PSRAM).
# These get baked into sdkconfig on first idf.py build.

CONFIG_IDF_TARGET="esp32s3"

# Enable C++ exceptions — RTReticulum throws on a few error paths.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0

# USB-Serial-JTAG console so esptool/idf.py flash + monitor over
# /dev/ttyACM0 work.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WiFi station + lwip (gRPC GetCalendar over :50051).
CONFIG_ESP_WIFI_ENABLED=y

# FreeRTOS config — recursive mutexes are used by Transport.
CONFIG_FREERTOS_HZ=1000

# Stack and task tuning. Reticulum loop is spawned with 8192 words of
# stack from app_main.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable mbedTLS algorithms RTReticulum needs.
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HKDF_C=y

# Optimisation: -Os keeps flash usage down.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# N16R8: 16MB flash. With octal PSRAM the flash must run in OPI mode.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y

# N16R8: 8MB octal PSRAM @ 80MHz (LVGL frame buffers live here).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Custom partition table (nvs + factory app sized 4MB).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- LVGL 9.3 Kconfig -------------------------------------------------------
# Intent (symbol names are for the lvgl/lvgl 9.3 component Kconfig; if the
# integrator's component build reports unknown symbols, map these intents to
# whatever names Kconfig exposes — e.g. 1-bit color depth may be the choice
# CONFIG_LV_COLOR_DEPTH_1=y or CONFIG_LV_COLOR_DEPTH=1):
#   * 1-bit color depth (ST7305 is a 1-bit reflective LCD)
#   * XML declarative UI + Observer/Subject data binding
#   * Montserrat 14 + 20 fonts
CONFIG_LV_COLOR_DEPTH_1=y
CONFIG_LV_COLOR_DEPTH=1
CONFIG_LV_USE_XML=y
CONFIG_LV_USE_OBJ_NAME=y
# LVGL 9.3.0's XML engine (lv_xml_component.c) references lv_grad_dsc_t.params
# unguarded — only compiled in with complex gradients enabled. Harmless on a
# 1-bit panel (we never draw gradients); required for LV_USE_XML to compile.
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y
# FreeRTOS OS glue so lv_lock()/lv_unlock() are a real recursive mutex —
# net callbacks poke subjects from outside the LVGL task.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Examples reference fonts we don't enable (montserrat_18) — don't build them.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_USE_DEMO_WIDGETS is not set

