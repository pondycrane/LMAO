# gitignore private build secrets + IDF build artifacts for the RoboDog firmware
/local_secrets.h
/build/
/sdkconfig
/managed_components/
/dependencies.lock
# XiaoZhi voice-firmware SOURCE is fetched at build time (voice/fetch_xiaozhi.sh
# -> pinned upstream commit + sha256) and staged here; never committed.
/.xiaozhi/
# u8g2 is fetched at build time (u8g2_prepare.sh -> @u8g2 http_archive); only
# our ESP-IDF component wrapper is committed, the upstream csrc never is.
/components/u8g2/*
!/components/u8g2/CMakeLists.txt
/shots/
