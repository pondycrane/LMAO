menu "RoboDog kconfig-symbol completion"

    # IDF's component-manager kconfig pass (interface v4) counts any symbol
    # used in an `if:` clause of a DOWNLOADED component manifest but defined in
    # no loaded Kconfig as a "missed required option"; after the cmake retry it
    # still resolves to a fatal unless the count is zero.  On the pinned
    # esp-claw commit the two remaining orphans come from OPTIONAL REGISTRY
    # components that are always skipped on this board (espressif/knob defines
    # ESP_BOARD_DEV_KNOB_SUPPORT; espressif/usb_host_uac defines
    # CODEC_UAC_SUPPORT).  The board manager's own ESP_BOARD_DEV_* symbols are
    # all defined by espressif/esp_board_manager, so only defining the two
    # skipped-component symbols here keeps the missed-key set empty.
    config ESP_BOARD_DEV_KNOB_SUPPORT
        bool "knob support (defined here for skipped espressif/knob)"
        default n

    config CODEC_UAC_SUPPORT
        bool "UAC codec support (defined here for skipped espressif/usb_host_uac)"
        default n

    # Same class, second set: esp_audio_render / gmf_audio / esp_hls_stream
    # gate their optional deps on `$CONFIG{ESP_PLAYER_ENABLE_*}` in their
    # DOWNLOADED manifests, while esp_player's own Kconfig is not part of the
    # component-manager kconfig pass for this board.  Declaring them here
    # keeps the missed-key set empty (the values match the ones the IDF
    # config pass resolves for the player: audio + HLS on, video off).
    config ESP_PLAYER_ENABLE_AUDIO
        bool "esp_player audio (declared for the component-manager kconfig pass)"
        default y

    config ESP_PLAYER_ENABLE_HLS_IO
        bool "esp_player HLS IO (declared for the component-manager kconfig pass)"
        default y

    config ESP_PLAYER_ENABLE_VIDEO
        bool "esp_player video (declared for the component-manager kconfig pass)"
        default n

endmenu

menu "RoboDog Phase 0 probes"

    config ROBODOG_ASR_URL
        string "Whisper ASR transcription endpoint (device-facing)"
        default "http://192.168.50.27:8001/v1/audio/transcriptions"
        help
            OpenAI-compatible /v1/audio/transcriptions endpoint the device
            POSTs captured speech to.  The user's own Whisper endpoint;
            overridden per-build via the robodog sdkconfig fragment
            (CLAW_ASR_URL env) so LAN IPs never need committing.
            spark-5307 (Whisper :8001 + Qwen3-TTS :8004) is on the board's own
            192.168.50.0/24 subnet, so the device reaches it DIRECTLY — no
            host socat forward.  (When it lived on 192.168.10.0/24 the host
            forwarded 11801/11804; that is no longer needed.)

    config ROBODOG_ASR_MODEL
        string "ASR model name sent in the multipart form"
        default "whisper-1"

    config ROBODOG_ASR_MAX_RESPONSE
        int "Maximum ASR response body to buffer (bytes)"
        default 4096

    config ROBODOG_TTS_URL
        string "Qwen3-TTS endpoint (device-facing)"
        default "http://192.168.50.27:8004/v1/audio/speech"
        help
            OpenAI-compatible /v1/audio/speech endpoint the device POSTs JSON
            to.  Overridden per-build via CLAW_TTS_URL env.  Qwen3-TTS
            (spark-5307) is on the board's own 192.168.50.0/24 subnet, so the
            device reaches it directly.

    config ROBODOG_TTS_MODEL
        string "TTS model name in the request JSON"
        default "qwen3-tts"

    config ROBODOG_TTS_VOICE
        string "Global TTS voice override (empty = per-language)"
        default ""
        help
            Empty (the default) means per-language voices: English replies use
            CONFIG_ROBODOG_TTS_VOICE_EN (aiden, English-native) and Chinese
            replies use CONFIG_ROBODOG_TTS_VOICE_ZH (serena,
            Mandarin-native).  A non-empty value pins ONE timbre for every
            reply, overriding the per-language pair.

    config ROBODOG_TTS_VOICE_EN
        string "English TTS timbre"
        default "aiden"
        help
            English-native Qwen3-TTS timbre (aiden/ryan).  An English reply
            read by a Chinese-native timbre (serena/vivian/...) carries a
            Chinese accent that `instruct` cannot remove, so the English
            branch names a native timbre explicitly.

    config ROBODOG_TTS_VOICE_ZH
        string "Chinese TTS timbre"
        default "dylan"
        help
            The model's Beijing-native Chinese timbre.  `serena`'s Mandarin
            drifted between mainland- and Hong-Kong-flavoured run to run, and
            Taiwan has several Mandarin varieties, so a named Beijing-native
            speaker is the one fixed accent.  Used for every Chinese reply,
            and pinned in the request so the server's global pin cannot
            override it.

    config ROBODOG_TTS_SEED
        int "Fixed sampler seed sent with every TTS request"
        default 8
        help
            Qwen3-TTS samples codec tokens, so prosody (and the perceived
            accent) drifts between calls unless the sampler is seeded.  Every
            request sends this seed, so the same text reproduces the same WAV
            and a chunked reply keeps one voice across its sentences.

    config ROBODOG_TTS_INSTRUCT_ZH
        string "Chinese TTS delivery instruction"
        default "請用標準北京腔的普通話說話，發音清晰，語調自然，語速適中，不要帶台灣腔、粵語或南方口音。"
        help
            Sent as the request's `instruct` for every Chinese chunk (when
            the caller does not override it).  It names the Beijing accent
            explicitly: Taiwan has several Mandarin varieties, so a generic
            "standard Mandarin" instruction still let the model drift between
            sections.

    config ROBODOG_TTS_INSTRUCT_EN
        string "English TTS delivery instruction"
        default ""
        help
            Sent as the request's `instruct` for every English chunk.  Empty
            by default: the English-native timbre needs no accent
            instruction.

    config ROBODOG_LLM_TIMEOUT_MS
        int "Timeout for the rd_chat agent round-trip (ms)"
        default 90000

endmenu

menu "RoboDog Phase 2 voice loop"

    config ROBODOG_VOICE_MAX_SECS
        int "Max utterance capture length (seconds)"
        default 45
        help
            Hard cap on a single listen phase, so a mic that never VAD-stops
            (ambient noise) cannot buffer unbounded audio.

    config ROBODOG_VOICE_SPEECH_MAX_SECS
        int "Max continuous-speech length before the utterance is capped (seconds)"
        default 30
        range 1 60
        help
            Bounds the energy-VAD "speech" phase: if the mic stays above the
            VAD threshold without 800 ms of silence for this long (a
            saturated/echoing mic, or a user speaking non-stop), the capture
            is ended anyway and sent to ASR.  Prevents a noise listen from
            burning the whole VOICE_MAX_SECS window and transcribing half a
            minute of noise.  A normal push-to-talk utterance is far below
            this (the corpus scripts are ~3-10 s).

    config ROBODOG_VOICE_CAPTURE_STEP_SECS
        int "Utterance buffer growth step (seconds of audio)"
        default 2
        range 1 10
        help
            The utterance buffer grows on demand in steps of this many seconds
            of 16 kHz s16 audio (2 s = 64 KB), instead of being allocated at
            its VOICE_MAX_SECS worst case (45 s = 1.44 MB) on the first speech
            frame.  A single 1.44 MB *contiguous* SPIRAM block is not reliably
            available once a voice turn has run (the heap is fragmented by the
            turn's TTS slots / ASR buffers / LVGL), so the all-at-once
            allocation failed and every later listen collapsed straight back
            to idle — the reported "hit listen, the board switches right back
            to idle".  Small steps keep every allocation satisfiable while
            still allowing the full VOICE_MAX_SECS window for a long utterance.

    config ROBODOG_VOICE_MIN_SPEECH_MS
        int "Minimum accumulated speech before trailing silence ends the listen (ms)"
        default 100
        range 20 2000
        help
            The trailing-silence rule (VAD_SILENCE_MS=800) ends the utterance
            once 800 ms of quiet follows speech.  A single noise blip (chair
            creak, click, door) counted as speech, so the very next 800 ms of
            quiet closed the listen — typically BEFORE the user had said
            anything.  The turn then captured ~1.5 s of room noise, ASR
            returned no text, and the panel dropped straight back to idle:
            the other half of the reported "hit listen, it switches right back
            to idle".  Below this much accumulated speech the buffered audio
            is discarded as a blip and listening continues (still bounded by
            the no-speech timeout and the hard caps).  A click/creak is one or
            two 20 ms frames, so 100 ms (5 frames) rejects blips while keeping
            a real utterance — measured on this rig's marginal speaker->mic
            coupling, a short corpus utterance ("what time is it") only crosses
            the energy threshold for ~180-200 ms, so a higher floor silently
            discarded genuine speech and the listen bailed with 0 samples.

    config ROBODOG_VOICE_NO_SPEECH_TIMEOUT_MS
        int "Bail out of the listen phase if no speech within this many ms"
        default 12000
        help
            If no speech frame is detected within this window the capture is
            abandoned (nothing to transcribe), instead of blocking the voice
            task for the full VOICE_MAX_SECS.

    config ROBODOG_VOICE_BOOT_BUTTON
        bool "BOOT button (GPIO0) triggers rd_listen"
        default y
        help
            Wire the board's BOOT button (ESP32-S3 GPIO0, pulled-up active-low)
            to start a voice turn, so the user can push-to-talk without the
            console.  A 300 ms debounce in the ISR avoids re-triggers.  (GPIO0
            is a runtime input after boot; holding it during reset still enters
            ROM download mode, as on any ESP32-S3.)

    config ROBODOG_VOICE_TTS_SLOTS
        int "Number of TTS chunk buffers in the playback pipeline"
        default 5
        range 2 8
        help
            The chunk queue plays back-to-back while a background task
            synthesizes AHEAD of the speaker.  Qwen3-TTS returns each chunk's
            WAV whole (no streaming: time-to-first-byte == total) and its
            synthesis runs at roughly real time, so a one-step lookahead is
            not enough — when one fetch is slower than the previous chunk's
            playback the reply stalls between sentences.  This many slot
            buffers let the fetch worker stay several sentences ahead, which is
            what makes the read-out sound continuous.  Memory: SLOTS x
            TTS_MAX_RESPONSE bytes of PSRAM, allocated ONCE for the firmware's
            lifetime (never per turn / per chunk).  Keep the product comfortably
            below the free PSRAM (measured ~3.2 MB) — the capture buffer, ASR
            response and LVGL share the same heap.  5 slots x 384 KB (~1.9 MB)
            is the tuned default: it allows 3 fetches ahead (LOOKAHEAD), i.e.
            ~19 s of synthesized audio buffered in front of the speaker, which
            is what absorbs a slow/busy endpoint.  2 disables the deep pipeline
            and only keeps the synchronous fallback slot.

    config ROBODOG_VOICE_TTS_LOOKAHEAD
        int "Background TTS fetches kept in flight ahead of playback"
        default 3
        range 1 7
        help
            How many chunk fetches the pipeline keeps armed ahead of the
            speaker — and the number of CONCURRENT fetch workers, one per armed
            chunk.  Concurrency matters because the endpoint serializes
            synthesis but each request still costs the board a fixed ~0.5 s of
            HTTP setup + WAV download: with ONE worker that overhead lands
            between requests, the server idles while the board reads, and the
            measured device-side synthesis rate fell to ~1.1x real time —
            slower than playback, which opens the seam gaps.  Overlapping
            fetches hide the transfer under the server's next synthesis.  This
            is also the lookahead depth that absorbs a busy GPU host.  Clamped
            to SLOTS-2 by the firmware, so one slot always stays free for the
            synchronous fallback fetch (which is what keeps a failed fetch from
            ever skipping or reordering a chunk).

    config ROBODOG_VOICE_TTS_MAX_RESPONSE
        int "Maximum TTS response body to buffer per chunk (bytes)"
        default 393216
        help
            Qwen3-TTS returns a 24 kHz s16 WAV (~48 KB/s), so 384 KB covers a
            ~8 s chunk.  This is PER SLOT: with SLOTS buffers the pipeline
            holds SLOTS x this many bytes for the firmware's lifetime.  Keep
            MAX_CHARS in sync: a chunk whose WAV exceeds this would grow the
            slot buffer on the fly (the accumulator reallocs), which is exactly
            the heap churn this bound exists to avoid.  At ~15 chars/s of
            English speech, 96 bytes ~ 6.4 s ~ 307 KB; a CJK chunk of 96 bytes
            (~32 characters) is ~6.4 s ~ 307 KB.  Both fit with margin, and the
            5-slot pipeline (5 x 384 KB ~ 1.9 MB) leaves the rest of PSRAM to
            the capture buffer / ASR / LVGL.

    config ROBODOG_VOICE_TTS_MAX_CHARS
        int "Max bytes per spoken sentence chunk"
        default 96
        range 1 479
        help
            The esp-claw root agent is verbose by default (a full "what can
            you do" dump is 60+ s of speech), so the FULL reply is split into
            SENTENCE-ALIGNED chunks and each chunk is queued, spoken and
            appended to the on-screen reply in order — the whole reply is read
            out and rendered, not truncated to the first chunk.

            This is a PREFERRED budget, not a hard cap.  The cut lands after
            the last ".!?;" (or CJK 。！？；…) inside it; when the window ends
            mid-sentence the splitter runs on to the NEXT sentence ender, up
            to the RLCD command-field ceiling (479 bytes).  That is what keeps
            a seam from landing mid-sentence ("...and the blinds are" |
            "closed, so..."), which made the read-out sound broken even though
            every word was spoken.  A newline is only a WEAK fallback, used
            when the reply carries no sentence punctuation at all.  Cuts are
            always on a UTF-8 codepoint boundary, so CJK text is never split
            mid-character.  A shorter value gives snappier per-sentence
            pacing.
            Range 1..479: a chunk is rendered on the RLCD THROUGH the same
            UI command field that carries every on-screen line (robodog_ui
            text[480]), so a spoken chunk must ALWAYS fit that field or the
            panel would show a shorter "sentence" than the voice is
            reading (on-screen != spoken).  robodog_ui._Static_assert enforces
            this pairing at build time; keep the two bound definitions in
            sync.
            A smaller value shortens the wait before each sentence is spoken
            (synthesis is ~real time, so a chunk is heard about as long after
            it was queued as its own duration), while a larger value gives the
            TTS model more context for natural prosody.  96 bytes is the
            balance: ~6.4 s of speech per chunk, comfortably inside one
            pipeline slot, and — because Qwen3-TTS synthesizes at ~1.0x real
            time and serializes requests — near-UNIFORM chunk lengths are what
            keep the seams gapless (see TTS_FIRST_CHARS).  Sentence alignment
            makes lengths vary slightly (a long sentence overflows to its own
            end); the deep pipeline absorbs that.

    config ROBODOG_VOICE_TTS_OVERFLOW_CHARS
        int "Bytes a chunk may run past TTS_MAX_CHARS to finish a sentence"
        default 24
        range 0 383
        help
            Sentence alignment lets a chunk run past the preferred budget to
            reach its sentence ender, but the overflow has to stay inside the
            per-slot WAV buffer (CONFIG_ROBODOG_VOICE_TTS_MAX_RESPONSE, 384 KB
            = ~8.2 s of 24 kHz s16 audio).  96 + 24 = 120 bytes is ~8 s of
            Chinese (~4.5 chars/s at 3 bytes/char) or ~7 s of English, so the
            WAV always fits one slot.  Measured failure without a bound: a
            479-byte sentence produced a ~30 s WAV and the fetch failed with
            `response buffer grow failed` (394886 B), which dropped chunks.
            A sentence that cannot finish inside budget+overflow falls back to
            the last CLAUSE break (, ， 、 ： :), then a space, then a hard cut
            at the budget — a comma is a natural pause, a word cut is not.

    config ROBODOG_VOICE_TTS_FIRST_CHARS
        int "Max bytes for the FIRST spoken chunk"
        default 96
        range 1 479
        help
            The first chunk's synthesis is the entire time-to-first-audio, so a
            smaller budget starts the reply sooner — but a SHORT first chunk
            opens a gap at the first seam: the fetch worker cannot start
            chunk 2 before chunk 1 is synthesized, and when chunk 2's
            synthesis (proportional to its own length) is longer than chunk 1's
            playback, the speaker has nothing to say until it finishes.
            Measured on this endpoint (device-side RTF ~1.0, requests
            serialized): a 96-byte first chunk followed by 144-byte chunks
            produced a 7 s silence at the first seam, while UNIFORM chunks
            produced ~0 ms seams.  Keep this EQUAL to TTS_MAX_CHARS unless you
            deliberately trade first-audio latency against a first-seam gap.
            With sentence-aligned chunks a shorter first chunk is no longer a
            safe latency win: the NEXT chunk may be the long one that overflows
            to its sentence end, and that is exactly the first-seam gap above.

    config ROBODOG_VOICE_TTS_LEAD_KEEP_MS
        int "Leading silence kept at the start of every chunk (ms)"
        default 40
        range 0 1000
        help
            Qwen3-TTS pads every chunk's WAV with silence (measured ~90 ms
            lead-in, ~130 ms tail on this endpoint).  Played verbatim, each
            seam doubles that padding and the reply sounds like separate clips.
            The lead-in is trimmed down to this short budget: enough to keep a
            soft onset (a breathy "h", a "t") intact, little enough that the
            sentence starts right where the previous one ended.

    config ROBODOG_VOICE_TTS_TAIL_KEEP_MS
        int "Trailing silence kept at the end of every chunk (ms)"
        default 40
        range 0 1000
        help
            Trailing silence is trimmed to this short tail on EVERY chunk so a
            final plosive or breath is never clipped while the padding that
            would otherwise double up at the next sentence boundary is removed
            (measured ~130 ms of tail padding per chunk on this endpoint).

    config ROBODOG_VOICE_TTS_MAX_CHUNKS
        int "Maximum number of spoken sentence chunks per turn"
        default 64
        help
            Hard cap on the chunk queue so one pathological gigantic reply
            cannot exhaust memory; 64 x 240 chars bounds ~15 KB of chunk text
            (several minutes of speech).  If a reply needs more chunks the
            tail is dropped — but this is never silent: the turn logs
            `voice truncated: reply exceeds <n> chunks; the tail was NOT read
            out` and ends in a visible "truncated" state (never the
            false-complete idle), and the robodog-claw-voice-verify gate
            FAILs on the marker so a half-read reply can never pass as a full
            readout.  Prefer a shorter reply over raising this cap.

endmenu

menu "RoboDog Phase 3 omni realtime (vLLM-Omni OpenAI-Realtime)"

    config ROBODOG_RT_URL
        string "Omni realtime WebSocket URL"
        default "ws://192.168.50.27:8099/v1/realtime"
        help
            vLLM-Omni OpenAI-Realtime endpoint.  One session replaces the
            three serial HTTP hops of the Phase 2 loop (Whisper ASR ->
            claw_core -> Qwen3-TTS), each of which returned a WHOLE response
            before the next could start: measured 24-32 s from end-of-speech
            to first audio on this board.  An omni model streams transcript
            deltas AND PCM deltas from one session, so first audio lands after
            a fraction of a second of generation.

            Plain `/v1/realtime` is the TURN-mode endpoint, and it is the
            deployed lane.  The duplex deployment (`?duplex=1`) lets the model
            decide per commit whether to answer or keep listening: measured on
            this board's corpus, 2 of 5 turns ended with `response.listen` and
            produced NO answer at all, which a voice assistant cannot ship.
            Turn mode always answers a committed turn; measured 1.5-3.7 s from
            end-of-speech to first audio (vs 24-32 s for the Phase 2 chain).
            Full duplex is unusable here regardless — this board has no AEC,
            so the mic cannot be read while the speaker plays.  Overridden
            per-build from CLAW_RT_URL.

    config ROBODOG_RT_MODEL
        string "Model id sent in session.update"
        default "openbmb/MiniCPM-o-4_5"
        help
            Must match the model the server was started with; the duplex
            handler validates it against the served model.

    config ROBODOG_RT_INSTRUCTIONS
        string "Session instructions (persona + spoken-prose rule)"
        default "You are RoboDog, a friendly voice assistant on a desk display. Answer immediately in plain spoken prose, in one short sentence. Never show your reasoning or thinking. Never use markdown, headings, bullet lists, asterisks or emoji."
        help
            Session-level persona.  Kept short on purpose: every extra
            sentence is spoken aloud.  "Never show your reasoning" is load-
            bearing — without it MiniCPM-o streams its ` thinking` trace as the
            reply and the board reads the reasoning out loud (measured: a
            35 s read-out of internal monologue).  "No markdown" is the same
            rule the Phase 2 turn applies, since this path has no
            md_strip backstop (the reply goes straight to TTS).

    config ROBODOG_RT_TURN_MODE
        int "Default per-turn modality (0=auto, 1=omni direct, 2=agent)"
        default 0
        range 0 2
        help
            0 = auto: the turn router picks (capability keywords -> agent,
            everything else -> omni direct).  1 = omni answers the turn
            itself (audio+text out): fastest, but esp-claw's skills/MCP/tools
            are not in that path.  2 = omni transcribes only (text out) and
            esp-claw's claw_core answers, spoken by Qwen3-TTS: full
            capability, slower.

    config ROBODOG_RT_SILENCE_MS
        int "Trailing silence that ends the utterance (ms)"
        default 800
        range 200 3000
        help
            Client-side end-of-turn detector.  The session is opened with
            turn_detection=null and auto_response=false so the turn boundary
            is OURS: the board commits when it decides the user stopped,
            never on a server heuristic (which would answer mid-sentence).

    config ROBODOG_RT_MAX_SECS
        int "Hard cap on a single streamed utterance (seconds)"
        default 30
        range 5 120
        help
            Bounds the streaming window so a saturated mic cannot stream
            forever.  Audio is appended as it is captured, so there is no
            large utterance buffer to exhaust (the Phase 2 capture cliff
            cannot recur).

    config ROBODOG_RT_TIMEOUT_MS
        int "Response timeout after commit (ms)"
        default 60000
        range 5000 180000
        help
            How long to wait for response.done.  The model streams audio as
            it generates, so this only bounds a wedged session.

    config ROBODOG_RT_QUEUE_DEPTH
        int "Playback queue depth (audio delta buffers)"
        default 16
        range 8 64
        help
            Audio deltas arrive faster than real time and are played paced.
            This many decoded-PCM buffers absorb the burst; each is capped by
            ROBODOG_RT_DELTA_MAX_BYTES.
            Memory: DEPTH x DELTA_MAX_BYTES of PSRAM, allocated ONCE at init.
            Keep the product small — the board has ~3.2 MB of SPIRAM free at
            boot and the WS event buffer + decode scratch share it.  Measured:
            a delta is ~40-56 KB of PCM, and the server sends ~1.5 MB of audio
            for a 30 s reply, so 16 slots (~1 MB) absorbs the burst with
            plenty of headroom; 48 slots (3 MB) exhausted SPIRAM and the
            websocket client then failed to init.

    config ROBODOG_RT_DELTA_MAX_BYTES
        int "Largest audio delta accepted (bytes)"
        default 65536
        help
            A delta bigger than this is dropped with a loud log rather than
            growing a buffer mid-stream (the R7 heap-churn class of bug).

endmenu
