+ * dependency on that component. */
+void robodog_rdshot_publish(const uint8_t *buf, size_t len, int w, int h);
+
+/* dev_display_lcd_config_t / dev_display_lcd_handles_t are defined by
+ * esp_board_manager's dev_display_lcd.h, which is only on the include path
+ * when CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT is enabled in the final
+ * sdkconfig.  With ESP-IDF 5.5.x that flag is silently DROPPED from the board
+ * sdkconfig.defaults (the esp_board_manager Kconfig symbol is unknown at
+ * defconfig-merge time), so the header and types are unavailable.  Instead of
+ * depending on the config gate, define layout-identical local types: the config
+ * is only passed to esp_board_device_override_config()/memcmp and the custom
+ * device init ignores it, so the struct contents are the only contract.
+ */
+typedef struct {
+    esp_lcd_panel_io_handle_t io_handle;
+    esp_lcd_panel_handle_t    panel_handle;
+} robodog_display_lcd_handles_t;
+
+typedef struct {
+    const char             *name;
+    const char             *chip;
+    const char             *sub_type;
+    uint16_t                lcd_width;
+    uint16_t                lcd_height;
+    uint8_t                 swap_xy : 1;
+    uint8_t                 mirror_x : 1;
+    uint8_t                 mirror_y : 1;
+    uint8_t                 need_reset : 1;
+    uint8_t                 invert_color : 1;
+    lcd_rgb_element_order_t rgb_ele_order;
+    lcd_rgb_data_endian_t   data_endian;
+    uint32_t                bits_per_pixel;
+} robodog_display_lcd_config_t;
 
