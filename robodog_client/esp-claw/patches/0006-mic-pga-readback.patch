RoboDog #301: state the live ES7210 mic PGA on the console, expose it to the
RT lane, and force it to +37.5 dB when the high-level
esp_codec_dev_set_in_gain() call did not land.

esp_codec_dev's set_in_gain() ignores the codec driver's return value, so a
rejected I2C write silently leaves the ADC at 0 dB while the capture hub
believes it set 42 dB.  Reading registers 0x43/0x44 back makes the bench
console state the gain the ADC actually runs at.

--- a/components/common/audio_hub/include/audio_capture.h
+++ b/components/common/audio_hub/include/audio_capture.h
@@ -47,6 +47,12 @@
 esp_err_t audio_capture_set_input_gain(audio_capture_handle_t capture, float gain_db);
 esp_err_t audio_capture_get_input_gain(audio_capture_handle_t capture, float *out_gain_db);
 
+/* Live codec mic PGA (ES7210 reg 0x43 low nibble: 0 = 0 dB, 10 = 30 dB,
+ * 14 = 37.5 dB).  Unlike audio_capture_get_input_gain(), which returns the
+ * value the hub asked for, this reads the codec back - the value the ADC
+ * actually runs at.  Returns -1 when the codec cannot be read. */
+int audio_capture_get_mic_pga(audio_capture_handle_t capture);
+
 /* One subscriber per role; a second open returns ESP_ERR_INVALID_STATE. */
 esp_err_t audio_capture_open_subscriber(audio_capture_handle_t capture, audio_capture_subscriber_role_t role, const audio_capture_sub_format_t *fmt, const char *owner_tag, audio_capture_sub_handle_t *out_sub);
 
--- a/components/common/audio_hub/src/audio_capture.c
+++ b/components/common/audio_hub/src/audio_capture.c
@@ -453,6 +453,27 @@
         if (cret != ESP_CODEC_DEV_OK) {
             ESP_LOGW(TAG, "set default input_gain=%d dB failed: %d", (int)h->input_gain_db, cret);
         }
+        /* RoboDog (#301): read the ES7210 PGA back.  esp_codec_dev swallows the
+         * codec driver's set_mic_gain() return value, so a rejected/failed I2C
+         * write would silently leave the ADC at 0 dB and the corpus under the
+         * VAD floor.  Registers 0x43..0x46 hold MIC1..MIC4 gain in the low
+         * nibble (bit4 = enable; 0 = 0 dB, 10 = 30 dB, 14 = 37.5 dB). */
+        int reg_mic1 = -1;
+        int reg_mic2 = -1;
+        int r1 = esp_codec_dev_read_reg(h->codec_dev, 0x43, &reg_mic1);
+        int r2 = esp_codec_dev_read_reg(h->codec_dev, 0x44, &reg_mic2);
+        ESP_LOGI(TAG, "mic pga readback: mic1=0x%02x mic2=0x%02x (read %d/%d) requested=%d dB",
+                 reg_mic1, reg_mic2, r1, r2, (int)h->input_gain_db);
+        if (r1 == ESP_CODEC_DEV_OK && (reg_mic1 & 0x0f) == 0) {
+            /* The high-level gain call did not land: force MIC1/MIC2 to the
+             * +37.5 dB ceiling so a bench run can measure what the ADC can
+             * actually deliver on this rig. */
+            ESP_LOGW(TAG, "mic pga still 0 dB - forcing ES7210 MIC1/MIC2 to +37.5 dB");
+            esp_codec_dev_write_reg(h->codec_dev, 0x43, 0x10 | 14);
+            esp_codec_dev_write_reg(h->codec_dev, 0x44, 0x10 | 14);
+            esp_codec_dev_read_reg(h->codec_dev, 0x43, &reg_mic1);
+            ESP_LOGI(TAG, "mic pga after force: mic1=0x%02x", reg_mic1);
+        }
     }
 
     h->running = true;
@@ -503,6 +524,21 @@
     return ESP_OK;
 }
 
+int audio_capture_get_mic_pga(audio_capture_handle_t capture)
+{
+    if (capture == NULL || capture->codec_dev == NULL) {
+        return -1;
+    }
+    int reg = -1;
+    xSemaphoreTake(capture->mtx, portMAX_DELAY);
+    int cret = esp_codec_dev_read_reg(capture->codec_dev, 0x43, &reg);
+    xSemaphoreGive(capture->mtx);
+    if (cret != ESP_CODEC_DEV_OK) {
+        return -1;
+    }
+    return reg & 0x0f;
+}
