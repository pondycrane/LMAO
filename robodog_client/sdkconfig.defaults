# RoboDog native display — ESP32-S3 minimal configuration.
# Board: Waveshare ESP32-S3 (16MB flash / octal 8MB PSRAM) + RLCD-4.2 (ST7305).
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Custom partition table: roomy 8M factory app (+ NVS for watermark/cache).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM so the u8g2 full-frame tile buffer lives outside internal SRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# WiFi station into a sleepy 1 kHz tick loop.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_ENABLED=y

# Allow light-sleep frequency scaling between calendar syncs.
CONFIG_PM_ENABLE=y

# The main task runs the whole display loop: WiFi connect, the framed-TCP
# calendar sync (lwIP getaddrinfo + esp_log formatting), the u8g2 render and
# the 15200-byte RD_SHOT printf dump.  The IDF default (3584 B) overflowed as
# soon as the weather band/forecast slot added a few dozen more locals to
# render_screen — the panel reset-looped right after getting an IP.  8 KB gives
# the sync+render+dump chain room to spare (the boot log prints the high-water
# mark so the headroom is observable, not assumed).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
