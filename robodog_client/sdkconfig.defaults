# RoboDog native display — ESP32-S3 minimal configuration.
# Board: Waveshare ESP32-S3 (16MB flash) + RLCD-4.2 (ST7305).
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Custom partition table: roomy 8M factory app (+ NVS for watermark/cache).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# No PSRAM: the 15,200-byte u8g2 frame buffer lives in internal SRAM (the
# Waveshare low-power demo does the same).  An idle PSRAM is powered and
# self-refreshed through light sleep for no benefit here, and skipping its
# init also shortens boot.  rd_render_init() asks for internal RAM.
# CONFIG_SPIRAM is not set

# 1 kHz tick so the USB-Serial/JTAG SOF monitor can resolve connect/disconnect
# within a few ms (USJ_DISCONNECT_CONFIRM_PERIOD_MS = 3 ticks).
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_ENABLED=y

# Power management: automatic light sleep is what makes the hold between
# calendar syncs cheap.  Tickless idle turns vTaskDelay() into a light sleep;
# WiFi is stopped for the hold, so no PM lock keeps the SoC awake.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# 80 MHz is ample for a protobuf decode + u8g2 render + 24 MHz SPI push.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# USB-Serial/JTAG cannot run across light sleep.  This holds a NO_LIGHT_SLEEP
# lock only while a host is attached (SOF packets), so the bench/capture rig
# keeps its console and the board still sleeps on battery.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# The main task runs the whole display loop: WiFi connect, the framed-TCP
# calendar sync (lwIP getaddrinfo + esp_log formatting), the u8g2 render and
# the 15200-byte RD_SHOT printf dump.  The IDF default (3584 B) overflowed as
# soon as the weather band/forecast slot added a few dozen more locals to
# render_screen — the panel reset-looped right after getting an IP.  8 KB gives
# the sync+render+dump chain room to spare (the boot log prints the high-water
# mark so the headroom is observable, not assumed).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
