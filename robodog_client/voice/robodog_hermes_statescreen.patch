diff --git a/main/boards/waveshare/esp32-s3-rlcd-4.2/robodog_statescreen.cc b/main/boards/waveshare/esp32-s3-rlcd-4.2/robodog_statescreen.cc
new file mode 100644
index 0000000..ac5da0e
--- /dev/null
+++ b/main/boards/waveshare/esp32-s3-rlcd-4.2/robodog_statescreen.cc
@@ -0,0 +1,427 @@
+#include "robodog_statescreen.h"
+
+#include "lvgl_theme.h"
+
+#include <cstring>
+
+namespace {
+
+// Reveal pace: 250 ms/word (deterministic word-by-word reveal of the received
+// stt/reply text on the canvas — see "Patterns to Mirror" in the plan).
+constexpr uint32_t kRevealPeriodMs = 250;
+// Cursor pulse period: ~600 ms on/off (seeded phase via esp_random()).
+constexpr uint32_t kPulsePeriodMs = 600;
+// One ASCII space of the 30 px basic-Latin font ~ 0.6 * line height.
+constexpr lv_coord_t kCharCellFrac = 3;   // cell_w_ = line_h_ * 3 / 5
+
+}  // namespace
+
+RoboDogStateScreen::RoboDogStateScreen(lv_obj_t* parent, LvglTheme* theme)
+    : theme_(theme) {
+    // Retain the theme's text font so the raw lv_font_t* we hand the labels
+    // stays alive for this screen's whole lifetime. The stock boot flow calls
+    // SetupUI() BEFORE the async assets loader swaps the theme's text_font_
+    // shared_ptr (assets.cc SetTextFont / LcdDisplay::SetTextFont), so caching
+    // the raw pointer alone dangles and the first STT-render measure crashed in
+    // lv_font_get_glyph_width() with a Guru Meditation cache fault (the
+    // robodog-voice-loop E2E regression: every conversation rebooted the board
+    // at the subtitle render). Owning the LvglFont keeps label text measurements
+    // valid; a (rare) theme swap just leaves us on the original font — visually
+    // identical for the RLCD's ASCII text font.
+    std::shared_ptr<LvglFont> font_keep;
+    if (theme_ != nullptr) {
+        font_keep = theme_->text_font();
+    }
+    text_font_ = font_keep;
+    const lv_font_t* font = font_keep ? font_keep->font() : nullptr;
+    if (font != nullptr) {
+        line_h_ = lv_font_get_line_height(font);
+    }
+    if (line_h_ <= 0) {
+        line_h_ = 30;
+    }
+    cell_w_ = (line_h_ * kCharCellFrac) / 5;
+    if (cell_w_ < 8) {
+        cell_w_ = 8;
+    }
+
+    // The 2-line canvas occupies the area under the top/status bars. Rendered
+    // through the normal LVGL flush path (never bypassed).
+    root_ = lv_obj_create(parent);
+    lv_obj_remove_style_all(root_);
+    lv_obj_set_size(root_, LV_HOR_RES - 16, line_h_ * 3);
+    lv_obj_set_pos(root_, root_x_, root_y_);
+    lv_obj_set_style_bg_color(root_, theme ? theme->background_color()
+                                           : lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(root_, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(root_, 0, 0);
+    lv_obj_set_style_pad_all(root_, 0, 0);
+
+    line1_ = lv_label_create(root_);
+    lv_obj_set_style_text_font(line1_, font, 0);
+    lv_obj_set_style_text_color(line1_, theme ? theme->text_color()
+                                              : lv_color_white(), 0);
+    lv_obj_set_pos(line1_, line_off_x_, line1_off_y_);
+    lv_label_set_text(line1_, "");
+
+    line2_ = lv_label_create(root_);
+    lv_obj_set_style_text_font(line2_, font, 0);
+    lv_obj_set_style_text_color(line2_, theme ? theme->text_color()
+                                              : lv_color_white(), 0);
+    lv_obj_set_pos(line2_, line_off_x_, line1_off_y_ + line_h_ + 8);
+    lv_label_set_text(line2_, "");
+
+    // Block cursor: an LVGL filled rectangle (no unicode block glyph needed),
+    // locked exactly one character cell ahead of the newest STT word.
+    block_ = lv_obj_create(root_);
+    lv_obj_remove_style_all(block_);
+    lv_obj_set_size(block_, cell_w_, (line_h_ * 3) / 4);
+    lv_obj_set_style_bg_color(block_, theme ? theme->text_color()
+                                            : lv_color_white(), 0);
+    lv_obj_set_style_bg_opa(block_, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(block_, 0, 0);
+    lv_obj_set_style_border_width(block_, 0, 0);
+    SetBlockVisible(false);
+
+    pulse_timer_ = lv_timer_create(RoboDogStateScreen::OnPulseTimer,
+                                   kPulsePeriodMs, this);
+    reveal_timer_ = lv_timer_create(RoboDogStateScreen::OnRevealTimer,
+                                    kRevealPeriodMs, this);
+    lv_timer_pause(pulse_timer_);
+    lv_timer_pause(reveal_timer_);
+
+    ShowCanvas(false);
+}
+
+RoboDogStateScreen::~RoboDogStateScreen() {
+    if (pulse_timer_ != nullptr) {
+        lv_timer_delete(pulse_timer_);
+        pulse_timer_ = nullptr;
+    }
+    if (reveal_timer_ != nullptr) {
+        lv_timer_delete(reveal_timer_);
+        reveal_timer_ = nullptr;
+    }
+}
+
+void RoboDogStateScreen::ShowCanvas(bool show) {
+    if (root_ == nullptr) {
+        return;
+    }
+    if (show) {
+        lv_obj_remove_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(root_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void RoboDogStateScreen::StartPulse() {
+    if (pulse_timer_ == nullptr) {
+        return;
+    }
+    // Seed the ON/OFF phase per turn so blind 3.2 s dumps see both phases.
+    pulse_on_ = (esp_random() & 1) != 0;
+    // This timer was created PAUSED (constructor) and only lv_timer_resume
+    // clears the paused flag (lv_timer_set_period/reset never do) — without it
+    // the block never pulses on-device (PR review R1).
+    lv_timer_set_period(pulse_timer_, kPulsePeriodMs);
+    lv_timer_resume(pulse_timer_);
+    lv_timer_reset(pulse_timer_);
+}
+
+void RoboDogStateScreen::StopPulse() {
+    if (pulse_timer_ != nullptr) {
+        lv_timer_pause(pulse_timer_);
+    }
+}
+
+void RoboDogStateScreen::StartReveal() {
+    if (reveal_timer_ == nullptr) {
+        return;
+    }
+    // Same paused-forever trap as StartPulse (PR review R1): the reveal timer
+    // is created paused in the constructor and must be resumed here or the
+    // word-by-word reveal (STT + streamed reply) never runs on-device.
+    lv_timer_set_period(reveal_timer_, kRevealPeriodMs);
+    lv_timer_resume(reveal_timer_);
+    lv_timer_reset(reveal_timer_);
+}
+
+void RoboDogStateScreen::StopReveal() {
+    if (reveal_timer_ != nullptr) {
+        lv_timer_pause(reveal_timer_);
+    }
+}
+
+std::vector<std::string> RoboDogStateScreen::SplitWords(
+    const std::string& text) const {
+    std::vector<std::string> out;
+    std::string cur;
+    for (char c : text) {
+        if ((c == ' ' || c == '\n' || c == '\t' || c == '\r') && !cur.empty()) {
+            out.push_back(cur);
+            cur.clear();
+        } else if (c != ' ' && c != '\n' && c != '\t' && c != '\r') {
+            cur.push_back(c);
+        }
+    }
+    if (!cur.empty()) {
+        out.push_back(cur);
+    }
+    return out;
+}
+
+std::string RoboDogStateScreen::Joined(size_t count,
+                                       const std::string& suffix) const {
+    std::string s;
+    for (size_t i = 0; i < count && i < words_.size(); i++) {
+        if (!s.empty()) {
+            s.push_back(' ');
+        }
+        s += words_[i];
+    }
+    s += suffix;
+    return s;
+}
+
+void RoboDogStateScreen::UpdateBlock() {
+    if (block_ == nullptr || line1_ == nullptr) {
+        return;
+    }
+    lv_obj_update_layout(line1_);
+    lv_coord_t text_w = lv_obj_get_width(line1_);
+    // One character cell exactly after the newest revealed word.
+    lv_obj_set_pos(block_, line_off_x_ + text_w + cell_w_,
+                   line1_off_y_ + (line_h_ - lv_obj_get_height(block_)) / 2);
+}
+
+void RoboDogStateScreen::SetBlockVisible(bool on) {
+    if (block_ == nullptr) {
+        return;
+    }
+    if (on) {
+        lv_obj_remove_flag(block_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(block_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void RoboDogStateScreen::RenderLine1() {
+    if (line1_ == nullptr) {
+        return;
+    }
+    lv_label_set_text(line1_, Joined(shown_, "").c_str());
+    lv_obj_update_layout(line1_);
+    // The block tracks the moving text edge only while we are LISTENING; the
+    // pulse timer toggles its visibility independently.
+    UpdateBlock();
+}
+
+void RoboDogStateScreen::RenderLine2() {
+    if (line2_ == nullptr) {
+        return;
+    }
+    if (state_ == RoboDogState::PROCESSING) {
+        lv_label_set_text(line2_, "...");
+    } else if (state_ == RoboDogState::RESPONDING) {
+        // The steady "_" is appended to the label so it rides the text edge for
+        // free, while the audio stream is running (streaming_).
+        lv_label_set_text(line2_,
+                          Joined(shown_, streaming_ ? "_" : "").c_str());
+    } else {
+        lv_label_set_text(line2_, "");
+    }
+    lv_obj_update_layout(line2_);
+}
+
+void RoboDogStateScreen::OnPulseTimer(lv_timer_t* timer) {
+    auto* self =
+        static_cast<RoboDogStateScreen*>(lv_timer_get_user_data(timer));
+    if (self == nullptr) {
+        return;
+    }
+    self->pulse_on_ = !self->pulse_on_;
+    switch (self->state_) {
+        case RoboDogState::LISTENING:
+            self->SetBlockVisible(self->pulse_on_);
+            if (self->reveal_done_for_hold_ && self->pulse_on_) {
+                // One full hold pulse after the STT reveal completed, then the
+                // cursor drops to line 2 as a pulsing "...".
+                self->reveal_done_for_hold_ = false;
+                self->BeginProcessing();
+            }
+            break;
+        case RoboDogState::PROCESSING:
+            if (self->line2_ != nullptr) {
+                if (self->pulse_on_) {
+                    lv_obj_remove_flag(self->line2_, LV_OBJ_FLAG_HIDDEN);
+                } else {
+                    lv_obj_add_flag(self->line2_, LV_OBJ_FLAG_HIDDEN);
+                }
+            }
+            break;
+        default:
+            break;  // RESPONDING/IDLE: no pulsing (the "_" is steady)
+    }
+}
+
+void RoboDogStateScreen::OnRevealTimer(lv_timer_t* timer) {
+    auto* self =
+        static_cast<RoboDogStateScreen*>(lv_timer_get_user_data(timer));
+    if (self == nullptr) {
+        return;
+    }
+    self->StopReveal();
+    if (self->reveal_label_ == self->line1_ && self->shown_ < self->words_.size()) {
+        self->shown_++;
+        self->RenderLine1();
+        if (self->shown_ >= self->words_.size()) {
+            // All STT words shown: hold LISTENING one pulse, then PROCESSING.
+            self->reveal_done_for_hold_ = true;
+        } else {
+            self->StartReveal();
+        }
+    } else if (self->reveal_label_ == self->line2_) {
+        if (self->shown_ < self->words_.size()) {
+            self->shown_++;
+            self->RenderLine2();
+        }
+        if (self->shown_ < self->words_.size()) {
+            self->StartReveal();
+        }
+        // Reply reveal finished: keep the steady "_" until tts-stream end.
+    }
+}
+
+void RoboDogStateScreen::BeginListening(const std::string& text) {
+    StopReveal();
+    words_ = SplitWords(text);
+    if (words_.empty()) {
+        return;  // empty stt: keep the previous presentation
+    }
+    shown_ = 1;  // comprehend the first word immediately
+    reveal_first_ = 0;
+    reveal_label_ = line1_;
+    reveal_role_ = RevealRole::LINE1;
+    reveal_done_for_hold_ = false;
+    state_ = RoboDogState::LISTENING;
+    streaming_ = false;
+    RenderLine1();
+    RenderLine2();  // starts empty
+    SetBlockVisible(pulse_on_);
+    lv_obj_remove_flag(line2_, LV_OBJ_FLAG_HIDDEN);
+    ShowCanvas(true);
+    StartPulse();
+    if (shown_ < words_.size()) {
+        StartReveal();
+    } else {
+        // Single-word utterance: hold LISTENING one pulse before processing.
+        reveal_done_for_hold_ = true;
+    }
+}
+
+void RoboDogStateScreen::BeginProcessing() {
+    StopReveal();
+    reveal_label_ = nullptr;
+    reveal_role_ = RevealRole::NONE;
+    // Keep the STT draft intact on line 1 (reveal already showed every word).
+    if (shown_ < words_.size()) {
+        shown_ = words_.size();  // tts start landed mid-reveal: jump to full draft
+        RenderLine1();
+    }
+    SetBlockVisible(false);
+    state_ = RoboDogState::PROCESSING;
+    RenderLine2();  // "..."
+    // The pulse timer now toggles line-2 visibility (start aligned to seed).
+    if (pulse_on_) {
+        lv_obj_remove_flag(line2_, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(line2_, LV_OBJ_FLAG_HIDDEN);
+    }
+    ShowCanvas(true);
+}
+
+void RoboDogStateScreen::BeginResponding(const std::string& text) {
+    StopReveal();
+    words_ = SplitWords(text);
+    reveal_first_ = 0;
+    reveal_label_ = line2_;
+    reveal_role_ = RevealRole::LINE2;
+    state_ = RoboDogState::RESPONDING;
+    streaming_ = true;
+    SetBlockVisible(false);
+    // The "..." is instantly overwritten: line 2 already holds the reply label,
+    // so the first replied word replaces it in-place (this call re-renders).
+    shown_ = 1;
+    lv_obj_remove_flag(line2_, LV_OBJ_FLAG_HIDDEN);
+    RenderLine2();  // first word + "_"
+    ShowCanvas(true);
+    StartPulse();  // keeps running (no-ops in RESPONDING) so a later PROCESSING
+                   // entry re-seeds from a fresh random phase
+    // No hold: the reply streams immediately (fixed word-reveal pace).
+    if (shown_ < words_.size()) {
+        StartReveal();
+    }
+}
+
+void RoboDogStateScreen::OnTtsStream(bool streaming) {
+    if (streaming) {
+        streaming_ = true;
+        if (state_ == RoboDogState::LISTENING ||
+            state_ == RoboDogState::PROCESSING) {
+            // The audio stream started without a caption text (or before it):
+            // still reach RESPONDING so the steady "_" is shown, and re-render
+            // so any mid-reveal STT draft gives way to the reply line.
+            BeginResponding("");
+        }
+        // Already RESPONDING with a caption: nothing to do (underscore shown).
+    } else {
+        EndResponding();
+    }
+}
+
+void RoboDogStateScreen::EndResponding() {
+    StopReveal();
+    StopPulse();
+    streaming_ = false;
+    reveal_label_ = nullptr;
+    reveal_role_ = RevealRole::NONE;
+    SetIdle();
+}
+
+void RoboDogStateScreen::ResetToIdle() { SetIdle(); }
+
+void RoboDogStateScreen::SetIdle() {
+    StopReveal();
+    StopPulse();
+    state_ = RoboDogState::IDLE;
+    streaming_ = false;
+    words_.clear();
+    shown_ = 0;
+    reveal_label_ = nullptr;
+    reveal_role_ = RevealRole::NONE;
+    reveal_done_for_hold_ = false;
+    pulse_on_ = false;
+    SetBlockVisible(false);
+    if (line1_ != nullptr) {
+        lv_label_set_text(line1_, "");
+    }
+    if (line2_ != nullptr) {
+        lv_label_set_text(line2_, "");
+    }
+    ShowCanvas(false);  // stock idle UI (status bar + emoji face) returns
+}
+
+const char* RoboDogStateScreen::StateName() const {
+    switch (state_) {
+        case RoboDogState::IDLE:
+            return "IDLE";
+        case RoboDogState::LISTENING:
+            return "LISTENING";
+        case RoboDogState::PROCESSING:
+            return "PROCESSING";
+        case RoboDogState::RESPONDING:
+            return "RESPONDING";
+    }
+    return "IDLE";
+}
