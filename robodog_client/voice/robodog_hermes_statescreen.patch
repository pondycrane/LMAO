+// ── RoboDog state-screen integration (robodog_hermes_statescreen.patch) ────
+// Build the stock idle UI via the base SetupUI() (top bar + status bar + emoji
+// idle face), then mount the 3-state conversation canvas below the status bar.
+// The canvas hides during IDLE so the stock UI — and thus hermes-e2e's
+// RECOGNIZABLE — stays legible. Everything renders through the NORMAL LVGL
+// flush path (no bypass), so the RD_SHOT capture hook keeps streaming frames
+// unchanged; the capture hook reads StatescreenActive()/RdShotState() for the
+// RD_SHOT `state=` label and the active-state dump cadence.
+
+void CustomLcdDisplay::SetupUI() {
+    LcdDisplay::SetupUI();  // stock: top bar, status bar, emoji idle face
+    DisplayLockGuard lock(this);
+    auto theme = static_cast<LvglTheme*>(current_theme_);
+    if (theme == nullptr) {
+        return;
+    }
+    if (statescreen_ == nullptr) {
+        statescreen_ = new RoboDogStateScreen(lv_screen_active(), theme);
+    }
+    stock_conversation_hidden_ = false;
+}
+
+void CustomLcdDisplay::SetChatMessage(const char* role, const char* content) {
+    if (statescreen_ == nullptr) {
+        LcdDisplay::SetChatMessage(role, content);
+        return;
+    }
+    DisplayLockGuard lock(this);
+    // Conversation frames drive the 3-state canvas; the stock chat bubbles /
+    // bottom bar are reserved for non-conversation (system) messages.
+    if (strcmp(role, "user") == 0 && content != nullptr && content[0] != '\0') {
+        statescreen_->BeginListening(content);
+        HideStockConversation();
+        return;
+    }
+    if (strcmp(role, "assistant") == 0 && content != nullptr && content[0] != '\0') {
+        statescreen_->BeginResponding(content);
+        HideStockConversation();
+        return;
+    }
+    // role == "system": an empty "" (audio channel closed / wake) returns the
+    // panel to the stock idle UI; non-empty system messages pass to the stock
+    // handler unchanged.
+    if (content == nullptr || content[0] == '\0') {
+        statescreen_->ResetToIdle();
+        ShowStockIdle();
+    }
+    LcdDisplay::SetChatMessage(role, content);
+}
+
+void CustomLcdDisplay::OnTtsStream(bool streaming) {
+    if (statescreen_ != nullptr) {
+        statescreen_->OnTtsStream(streaming);
+        // The tts stream ended -> the conversation is over. Restore the stock
+        // emoji idle face so it is not left hidden for the rest of the session
+        // (PR review R3: HideStockConversation() only had the converse path via
+        // SetChatMessage's empty-content branch, so multi-turn sessions never
+        // brought the face back). Symmetric with HideStockConversation().
+        if (!streaming && !statescreen_->Active()) {
+            ShowStockIdle();
+        }
+    }
+}
+
+// Callers hold the display lock (SetChatMessage above). Hiding the emoji face
+// once per conversation keeps the canvas unobscured; the bottom stock chat bar
+// never appears during a conversation because we intercept the user/assistant
+// frames before they reach the stock bubble renderer.
+void CustomLcdDisplay::HideStockConversation() {
+    if (stock_conversation_hidden_) {
+        return;
+    }
+    stock_conversation_hidden_ = true;
+    if (emoji_box_ != nullptr) {
+        lv_obj_add_flag(emoji_box_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (bottom_bar_ != nullptr) {
+        lv_obj_add_flag(bottom_bar_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void CustomLcdDisplay::ShowStockIdle() {
+    if (!stock_conversation_hidden_) {
+        return;
+    }
+    stock_conversation_hidden_ = false;
+    // Restore BOTH objects HideStockConversation() hid (PR review R3): the
+    // emoji idle face and the stock bottom chat bar.
+    if (emoji_box_ != nullptr) {
+        lv_obj_remove_flag(emoji_box_, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (bottom_bar_ != nullptr) {
+        lv_obj_remove_flag(bottom_bar_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+bool CustomLcdDisplay::StatescreenActive() {
+    return statescreen_ != nullptr && statescreen_->Active();
+}
+
+const char* CustomLcdDisplay::RdShotState() {
+    return statescreen_ != nullptr ? statescreen_->StateName() : "IDLE";
+}
