@@ -0,0 +1,109 @@
+#ifndef __ROBODOG_STATESCREEN_H__
+#define __ROBODOG_STATESCREEN_H__
+
+/*
+ * RoboDogStateScreen — the LMAO-injected 3-state conversation canvas for the
+ * hermes (XiaoZhi voice) build of the Waveshare ESP32-S3 RLCD-4.2 board.
+ *
+ * PRD presentation (see README "Voice mode"):
+ *   1. LISTENING   — comprehended STT words append left-to-right; a pulsing
+ *                    block cursor (an LVGL filled rectangle — U+2588 is not in
+ *                    the board font) stays locked exactly ONE character cell
+ *                    ahead of the newest word. No underline, no bold overdraw.
+ *   2. PROCESSING  — the cursor drops to a fresh line and becomes a pulsing
+ *                    "..." (three ASCII dots) on that line.
+ *   3. RESPONDING  — the "..." is instantly overwritten by the first replied
+ *                    word; the reply streams left-to-right; a steady ASCII "_"
+ *                    rides the moving text edge until the tts stream ends
+ *                    (OnTtsStream(false)).
+ *
+ * Everything renders through the NORMAL LVGL flush path (no flush bypass, no
+ * timer-driven RD_SHOT): this class is a plain set of LVGL objects, so the
+ * robodog_hermes_capture.patch RD_SHOT hook keeps streaming frames unchanged.
+ * Pulse phase is seeded from esp_random() on state entry so blind ~3.2 s dumps
+ * sample both pulse phases across E2E loops.
+ *
+ * This file is staged into the ESP-IDF tree by robodog_hermes_statescreen.patch
+ * (applied by build_xiaozhi.sh) — never committed as a vendored source.
+ */
+
+#include <lvgl.h>
+#include <esp_random.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+class LvglTheme;
+class LvglFont;
+
+enum class RoboDogState { IDLE, LISTENING, PROCESSING, RESPONDING };
+
+class RoboDogStateScreen {
+public:
+    RoboDogStateScreen(lv_obj_t* parent, LvglTheme* theme);
+    ~RoboDogStateScreen();
+
+    // Conversation hooks (called under DisplayLockGuard from the display
+    // override; the LVGL timer callbacks below run on the LVGL task).
+    void BeginListening(const std::string& text);   // stt draft -> LISTENING reveal
+    void BeginProcessing();                          // cursor drops -> "..." pulse
+    void BeginResponding(const std::string& text);   // reply -> overwrite "..." + steady "_"
+    void OnTtsStream(bool streaming);                // tts start/stop signal
+    void EndResponding();                            // tts-stream end: remove "_" -> IDLE
+    void ResetToIdle();                              // back to stock idle UI
+
+    RoboDogState state() const { return state_; }
+    bool Active() const { return state_ != RoboDogState::IDLE; }
+    const char* StateName() const;
+
+private:
+    enum class RevealRole { NONE, LINE1, LINE2 };
+
+    void ShowCanvas(bool show);
+    void SetIdle();
+    void StartPulse();
+    void StopPulse();
+    void StartReveal();
+    void StopReveal();
+    void RenderLine1();
+    void RenderLine2();
+    void UpdateBlock();
+    void SetBlockVisible(bool on);
+    std::vector<std::string> SplitWords(const std::string& text) const;
+    std::string Joined(size_t count, const std::string& suffix) const;
+
+    static void OnPulseTimer(lv_timer_t* timer);
+    static void OnRevealTimer(lv_timer_t* timer);
+
+    lv_obj_t* root_ = nullptr;    // the 2-line canvas (hidden when IDLE)
+    lv_obj_t* line1_ = nullptr;   // STT draft (line 1)
+    lv_obj_t* line2_ = nullptr;   // "..." indicator / reply stream (line 2)
+    lv_obj_t* block_ = nullptr;   // LVGL filled rectangle (listening cursor)
+    lv_timer_t* pulse_timer_ = nullptr;
+    lv_timer_t* reveal_timer_ = nullptr;
+
+    RoboDogState state_ = RoboDogState::IDLE;
+    LvglTheme* theme_ = nullptr;
+    std::shared_ptr<LvglFont> text_font_;  // retain the label font (dangle guard)
+
+    std::vector<std::string> words_;
+    size_t shown_ = 0;            // words revealed so far on the current line
+    size_t reveal_first_ = 0;     // index of the first word the reveal drives
+    bool reveal_done_for_hold_ = false;  // LISTENING reveal finished; hold one pulse
+    lv_obj_t* reveal_label_ = nullptr;
+    RevealRole reveal_role_ = RevealRole::NONE;
+
+    bool pulse_on_ = false;       // seeded from esp_random() on state entry
+    bool streaming_ = false;      // tts audio stream in progress -> steady "_"
+
+    lv_coord_t root_x_ = 8;
+    lv_coord_t root_y_ = 54;      // below the stock top/status bar
+    lv_coord_t line_off_x_ = 8;   // label inset inside the canvas
+    lv_coord_t line1_off_y_ = 6;
+    lv_coord_t line_h_ = 0;       // text font line height
+    lv_coord_t cell_w_ = 0;       // glyph advance (one character cell)
+};
+
+#endif  // __ROBODOG_STATESCREEN_H__
