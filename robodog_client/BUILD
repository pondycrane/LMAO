# Build/flash targets for the robodog_client firmware (Waveshare ESP32-S3
# RLCD, family-calendar display).  Build runs ESP-IDF in Docker; flash runs
# esptool on the HOST because Docker's ttyACM RTS passthrough breaks the
# button-free reset (EPROTO), see flash.sh.
#
#   bazel run //robodog_client:build_firmware
#   bazel run //robodog_client:flash_firmware [-- --port /dev/ttyACM0]

load("@rules_python//python:defs.bzl", "py_library")
load(":firmware_tools.bzl", "firmware_tool")

# Reusable by the RoboDog home client firmware (//robodog_home_client), which
# stages the same fetched u8g2 csrc + panel driver components.
exports_files([
    "flash.sh",
    "flash_common.sh",
    "xiaozhi_flash.sh",
    "esp-claw/flash_esp_claw.sh",
    "main/rd_store.h",
    "u8g2_prepare.sh",
    "components/u8g2/CMakeLists.txt",
    "components/u8g2_st7305/CMakeLists.txt",
    "components/u8g2_st7305/u8g2_st7305.c",
    "components/u8g2_st7305/u8g2_st7305.h",
])

filegroup(
    name = "u8g2_components",
    srcs = [
        "components/u8g2/CMakeLists.txt",
        "components/u8g2_st7305/CMakeLists.txt",
        "components/u8g2_st7305/u8g2_st7305.c",
        "components/u8g2_st7305/u8g2_st7305.h",
    ],
    visibility = ["//visibility:public"],
)


firmware_tool(
    name = "build_firmware",
    script = "build.sh",
    data = glob([
        "main/*",
        "components/**/*",
        "sdkconfig.defaults",
        "sdkconfig",
        "partitions.csv",
        "CMakeLists.txt",
    ]) + [
        # u8g2 upstream source is fetched (never vendored); carried in runfiles
        # so `bazel run //robodog_client:build_firmware` needs no network.
        "@u8g2//:src",
    ],
)

firmware_tool(
    name = "flash_firmware",
    script = "flash.sh",
    # build/nvs.bin is generated by flash.sh at run time (--kid-name) via the
    # IDF nvs_partition_gen.py and written at 0x9000; carried in runfiles in
    # case a prior run staged it (glob matches only existing files).
    data = glob([
        "build/flash_args",
        "build/robodog_client.bin",
        "build/nvs.bin",
    ]) + ["flash_common.sh"],
)

# ── Voice-AI firmware (XiaoZhi) — built from source, never vendored ───────
# The XiaoZhi AI voice firmware for the same Waveshare board is built from the
# PINNED UPSTREAM SOURCE (voice/build_xiaozhi.sh fetches the immutable
# 78/xiaozhi-esp32 commit, sha256-verified, into the gitignored .xiaozhi/)
# with the RoboDog capture hook applied — so the hermes board is verifiable
# pixel-for-pixel exactly like the calendar firmware (RD_SHOT frames over
# USB-JTAG consumed by capture.py). This replaces the calendar app — reflash
# //robodog_client:flash_firmware to restore the calendar firmware.
firmware_tool(
    name = "build_robodog_hermes",
    script = "voice/build_xiaozhi.sh",
    data = [
        "voice/fetch_xiaozhi.sh",
        "voice/robodog_hermes_capture.patch",
        "voice/robodog_hermes_display.patch",
    ],
)

firmware_tool(
    name = "flash_robodog_hermes",
    script = "xiaozhi_flash.sh",
    data = glob([
        ".xiaozhi/build/flash_args",
        ".xiaozhi/build/bootloader/bootloader.bin",
        ".xiaozhi/build/partition_table/partition-table.bin",
        ".xiaozhi/build/xiaozhi.bin",
    ]) + [
        "flash_common.sh",
        "voice/build_xiaozhi.sh",
        "voice/fetch_xiaozhi.sh",
        "voice/robodog_hermes_capture.patch",
        "voice/robodog_hermes_display.patch",
    ],
)

# ── ESP-Claw firmware (standalone on-device agent) — DESIGN.md Phase 1 ────
# The ESP-Claw edge_agent for the same Waveshare RLCD board is built from the
# PINNED UPSTREAM SOURCE (esp-claw/fetch_esp_claw.sh fetches the immutable
# espressif/esp-claw commit, sha256-verified, into the gitignored .esp-claw/)
# with the RoboDog Phase 1 overlay (LMAO-owned board setup_device.c + the
# deterministic text-only UI + rdshot/rd_asr/rd_tts/rd_chat probes) applied.
# ESP-IDF v5.5.4 is ESP-Claw's recommended IDF (NOT the v6.0.2 XiaoZhi image).
# See robodog_client/esp-claw/DESIGN.md. Replaces whichever firmware is on the
# board — reflash the calendar //robodog_client:flash_firmware or
# //robodog_client:flash_robodog_hermes to restore it.
firmware_tool(
    name = "build_robodog_claw",
    script = "esp-claw/build_esp_claw.sh",
    data = [
        "esp-claw/fetch_esp_claw.sh",
        "esp-claw/rewrite_component_paths.py",
        "esp-claw/patches/0002-init.patch",
        "esp-claw/patches/0003-audio-hub-24k.patch",
        "esp-claw/patches/0004-capture-drop-log-rate-limit.patch",
        "esp-claw/overlay/boards/waveshare_ESP32_S3_RLCD_4_2/setup_device.c",
        "esp-claw/overlay/components/robodog_phase0/CMakeLists.txt",
        "esp-claw/overlay/components/robodog_phase0/Kconfig",
        "esp-claw/overlay/components/robodog_phase0/idf_component.yml",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_phase0.h",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_ui.h",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_http.h",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_voice.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_split.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_transcript.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_md.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_pipeline.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_pcm.h",
        "esp-claw/gen_font_tc_16.sh",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_phase0.c",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_ui.c",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_utf8.h",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_utf8.c",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_http.c",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_voice.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_split.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_transcript.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_md.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_pipeline.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_pcm.c",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_realtime.h",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_realtime.c",
        "esp-claw/overlay/components/robodog_phase0/include/robodog_speaker.h",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_speaker.c",
        "esp-claw/overlay/components/robodog_phase0/include/voice_route.h",
        "esp-claw/overlay/components/robodog_phase0/src/voice_route.c",
        "esp-claw/overlay/components/robodog_phase0/include/voice_think.h",
        "esp-claw/overlay/components/robodog_phase0/src/voice_think.c",
        "esp-claw/omni_probe.py",
        "esp-claw/test_voice_split.c",
        "esp-claw/test_voice_pipeline.c",
        "esp-claw/test_voice_pcm.c",
        "esp-claw/robodog_claw_e2e.py",
        "esp-claw/robodog_claw_stress.py",
        "esp-claw/run_claw_stress.sh",
        "//robodog_client:voice_corpus",
    ],
)

firmware_tool(
    name = "flash_robodog_claw",
    script = "esp-claw/flash_esp_claw.sh",
    # .esp-claw/build outputs are generated at build time; glob matches only
    # existing files so the target builds even before the first build runs.
    data = glob([
        ".esp-claw/application/edge_agent/build/flash_args",
        ".esp-claw/application/edge_agent/build/bootloader/bootloader.bin",
        ".esp-claw/application/edge_agent/build/partition_table/partition-table.bin",
        ".esp-claw/application/edge_agent/build/edge_agent.bin",
        ".esp-claw/application/edge_agent/build/ota_data_initial.bin",
    ]) + [
        "flash_common.sh",
        "esp-claw/build_esp_claw.sh",
        "esp-claw/fetch_esp_claw.sh",
    ],
)

# ── Host-testable pure-C voice units (R6/R7) ───────────────────────────────
# The whole-reply chunk splitter (voice_split.c) and the transcript
# join+cap-keep helper (voice_transcript.c) are PURE C (no ESP-IDF deps) and
# are compiled by BOTH the device firmware (robodog_phase0 component, src/ +
# include/) and this host cc_test — so the lossless/ordered/<=cap readout
# invariants and the display/audio accumulation rules are proven under Bazel
# against the exact source that runs on the board (DRY, same pattern as
# //firmware_common:lma_encoder).
cc_library(
    name = "esp_claw_voice_pure",
    srcs = [
        "esp-claw/overlay/components/robodog_phase0/src/voice_split.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_transcript.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_md.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_pipeline.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_pcm.c",
        "esp-claw/overlay/components/robodog_phase0/src/robodog_utf8.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_route.c",
        "esp-claw/overlay/components/robodog_phase0/src/voice_think.c",
    ],
    hdrs = [
        "esp-claw/overlay/components/robodog_phase0/include/robodog_utf8.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_split.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_transcript.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_md.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_pipeline.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_pcm.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_route.h",
        "esp-claw/overlay/components/robodog_phase0/include/voice_think.h",
    ],
    strip_include_prefix = "esp-claw/overlay/components/robodog_phase0/include",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "test_voice_split",
    srcs = [
        "esp-claw/test_voice_split.c",
        "esp-claw/test_voice_pipeline.c",
        "esp-claw/test_voice_pcm.c",
        "esp-claw/test_robodog_utf8.c",
    ],
    deps = [":esp_claw_voice_pure"],
)

# ── Voice-AI backend glue (host-side services) ────────────────────────────
# Bridge + TTS server + systemd units that give the XiaoZhi voice firmware a
# local conversation loop (see README "Voice mode"). Reference/deploy copy —
# the running instance is ops-managed at ~/xiaozhi + spark-5307:8004.
#
# The bridge/E2E run under the ops venv (~/xiaozhi/.venv): their Python deps
# (faster_whisper, fastapi, numpy, opuslib, soundfile, pyserial, pillow ...)
# are NOT in the @lmao_pip bazel set, so these are sh_binary entrypoints that
# exec the SOURCE-TREE copy (via BUILD_WORKSPACE_DIRECTORY on `bazel run`) in
# that venv — the same host-venv pattern as the firmware flash/build targets.
#
#   bazel run //robodog_client:hermes_voice_e2e [-- --corpus count]
#   bazel run //robodog_client:make_corpus [-- --verify]
sh_binary(
    name = "hermes_voice_e2e",
    srcs = ["voice/run_hermes_voice_e2e.sh"],
    data = [
        "capture.py",
        "voice/hermes_voice_e2e.py",
        "voice/voice_bridge.py",
        "voice/e2e_readout.py",
        "//robodog_client:voice_corpus",
    ],
    tags = ["manual"],
)

# Multi-session gapless-prefetch STRESS (one-step TTS lookahead): runs the
# dedicated voice-verify gate E2E_RUNS times with corpus cycling (different
# question per session) and scans the whole run for reset/panic sentinels -
# the DESIGN.md R7 soak regression check for the new sustained-load path.
# Host-python tool, exactly like the hermes e2e sh_binary (never writes
# hardware-e2e.md / .gate-head).
#
#   bazel run //robodog_client:claw_stress [-- --artifacts DIR --runs 5]
sh_binary(
    name = "claw_stress",
    srcs = ["esp-claw/run_claw_stress.sh"],
    data = [
        "capture.py",
        "esp-claw/robodog_claw_stress.py",
        "esp-claw/robodog_claw_e2e.py",
        "//robodog_client:voice_corpus",
    ],
    tags = ["manual"],
)

# ESP-Claw voice-loop E2E as a `bazel run` target (the hermes E2E already had
# one; claw previously required knowing the script path).
firmware_tool(
    name = "claw_e2e",
    script = "esp-claw/run_claw_e2e.sh",
    data = [
        "capture.py",
        "esp-claw/robodog_claw_e2e.py",
        "//robodog_client:voice_corpus",
    ],
)

sh_binary(
    name = "make_corpus",
    srcs = ["voice/run_make_corpus.sh"],
    data = ["voice/make_corpus.py"],
    tags = ["manual"],
)

filegroup(
    name = "voice_corpus",
    srcs = [
        "voice/corpus/corpus.json",
    ] + glob(["voice/corpus/*.wav"]) + glob(["voice/corpus/*.txt"]),
    tags = ["manual"],
)

filegroup(
    name = "voice_backend",
    srcs = [
        "voice/voice_bridge.py",
        "voice/kokoro_server.py",
        "voice/lmao-robodog-voice.service",
        "voice/kokoro-tts.service",
        "voice/hermes_voice_e2e.py",
        "voice/make_corpus.py",
        "voice/e2e_readout.py",
        "voice/corpus/corpus.json",
    ] + glob(["voice/corpus/*.wav"]) + glob(["voice/corpus/*.txt"]),
    tags = ["manual"],
)

# Host-side voice bridge, as a Bazel Python library so //tests:test_voice_bridge
# can import it. The bridge itself runs under the ops venv (~/xiaozhi/.venv);
# its runtime deps (fastapi, faster_whisper, numpy, opuslib, websockets) are NOT
# in @lmao_pip, so unit tests stub those modules in sys.modules before importing
# (see tests/test_voice_bridge.py) and this target needs no pip deps to build.
py_library(
    name = "voice_bridge",
    srcs = ["voice/voice_bridge.py"],
    visibility = ["//tests:__pkg__"],
)

# RD_SHOT frame parser + the shared E2E rig helpers, as Bazel libraries so the
# host tests can exercise the ONE parser/rig implementation (capture.py and
# e2e_rig.py import serial/PIL; both are in @lmao_pip).
py_library(
    name = "capture_lib",
    srcs = ["capture.py"],
    visibility = ["//tests:__pkg__"],
    deps = [
        "@lmao_pip//pillow",
        "@lmao_pip//pyserial",
    ],
)

py_library(
    name = "e2e_rig_lib",
    srcs = [
        "e2e_rig.py",
        "voice/e2e_readout.py",
    ],
    imports = ["."],
    visibility = ["//tests:__pkg__"],
    deps = ["@lmao_pip//pyserial"],
)

# Read-out metrics for the voice-loop E2E (issue #274) — pure stdlib so
# //tests:test_e2e_readout runs without the ops venv.
py_library(
    name = "e2e_readout",
    srcs = ["voice/e2e_readout.py"],
    visibility = ["//tests:__pkg__"],
)

# ── Host-testable pure-C calendar/panel units ─────────────────────────────
# lma_proto (wire codec), rd_datetime (row meta/qualifiers), rd_clip (measured
# clipping) and rd_weather (WMO label + °C→°F) are dependency-free C compiled
# by BOTH the device firmware (main/CMakeLists.txt) and these host cc_tests, so
# the wire decode, the date qualifiers, the clip budget and the weather
# formatting are proven under Bazel against the exact source that runs on the
# board (same pattern as //firmware_common:lma_encoder and the esp-claw units).
cc_library(
    name = "robodog_pure",
    srcs = [
        "main/lma_proto.c",
        "main/rd_clip.c",
        "main/rd_datetime.c",
        "main/rd_layout.c",
        "main/rd_weather.c",
    ],
    hdrs = [
        "main/lma_proto.h",
        "main/rd_clip.h",
        "main/rd_datetime.h",
        "main/rd_layout.h",
        "main/rd_weather.h",
    ],
    strip_include_prefix = "main",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "test_lma_proto",
    srcs = ["main/lma_proto_selftest.c"],
    deps = [":robodog_pure"],
)

cc_test(
    name = "test_rd_datetime",
    srcs = ["main/rd_datetime_selftest.c"],
    deps = [":robodog_pure"],
)

cc_test(
    name = "test_rd_weather",
    srcs = ["main/rd_weather_selftest.c"],
    deps = [":robodog_pure"],
)

# The clip/wrap boundary search and the panel-layout fit arithmetic had no
# Bazel target at all: the "host cc gate" was a copy-paste line in a comment,
# so they could silently stop being run.  Both now run here.
cc_test(
    name = "test_rd_clip",
    srcs = ["main/rd_clip_selftest.c"],
    deps = [":robodog_pure"],
)

cc_test(
    name = "test_rd_layout",
    srcs = ["main/rd_layout_selftest.c"],
    deps = [":robodog_pure"],
)

