# Build/flash targets for the robodog_client firmware (Waveshare ESP32-S3
# RLCD, family-calendar display).  Build runs ESP-IDF in Docker; flash runs
# esptool on the HOST because Docker's ttyACM RTS passthrough breaks the
# button-free reset (EPROTO), see flash.sh.
#
#   bazel run //robodog_client:build_firmware
#   bazel run //robodog_client:flash_firmware [-- --port /dev/ttyACM0]

sh_binary(
    name = "build_firmware",
    srcs = ["build.sh"],
    data = glob([
        "main/*",
        "components/**/*",
        "sdkconfig.defaults",
        "sdkconfig",
        "partitions.csv",
        "CMakeLists.txt",
    ]) + [
        # u8g2 upstream source is fetched (never vendored); carried in runfiles
        # so `bazel run //robodog_client:build_firmware` needs no network.
        "@u8g2//:src",
    ],
    tags = ["manual"],
)

sh_binary(
    name = "flash_firmware",
    srcs = ["flash.sh"],
    # build/nvs.bin is generated by flash.sh at run time (--kid-name) via the
    # IDF nvs_partition_gen.py and written at 0x9000; carried in runfiles in
    # case a prior run staged it (glob matches only existing files).
    data = glob([
        "build/flash_args",
        "build/robodog_client.bin",
        "build/nvs.bin",
    ]),
    tags = ["manual"],
)

# ── Voice-AI firmware (XiaoZhi) — fetched, never vendored ─────────────────
# The XiaoZhi AI voice firmware for the same Waveshare board is a prebuilt
# release fetched via the robodog_xiaozhi_fetch() macro in repos.bzl (Bazel
# cache + immutable commit + sha256 pin). This replaces the calendar app —
# reflash //robodog_client:flash_firmware to restore the calendar firmware.
genrule(
    name = "xiaozhi_fw_bin",
    srcs = ["@xiaozhi_rlcd_firmware//file"],
    outs = ["xiaozhi_fw/merged-binary.bin"],
    cmd = "unzip -p $(location @xiaozhi_rlcd_firmware//file) merged-binary.bin > $@",
    tags = ["manual"],
)

sh_binary(
    name = "flash_robodog_hermes",
    srcs = ["xiaozhi_flash.sh"],
    data = [":xiaozhi_fw_bin"],
    tags = ["manual"],
)
