# cluster-watchdog.env — copy to ~/.config/lmao/cluster-watchdog.env
# (install.sh writes it there). Defaults shown.

# Registry the cluster pulls from (hostname, never its DHCP LAN IP).
REGISTRY="op4:5000"

# The server's LXMF delivery hash. Leave empty to skip the drift check; set it
# so a replaced identity PVC is caught (clients are flashed against this hash).
EXPECTED_DEST_HASH=""

# Pipeline silence threshold, in hours. The Cardputer reports every 300 s, so
# anything beyond a couple of hours means the device stopped sending.
PIPELINE_THRESHOLD_H="3"

# Warn when a node's root filesystem reaches this percentage.
DISK_WARN_PCT="85"

# Recovery guard: minimum seconds between the same action, and the number of
# attempts allowed per hour before the watchdog gives up and alerts.
RECOVERY_COOLDOWN_SEC="900"
RECOVERY_MAX_ATTEMPTS="3"

# Where reports and agent logs live.
STATE_DIR="~/.local/state/lmao-watchdog"

# Headless agent. Primary is a local node that does not depend on the cluster
# being diagnosed; the cloud model is the fallback when that node is down.
OMP_BIN="~/.local/bin/omp"
AGENT_MODEL="spark-73dd/qwen3.8-flash-next"
AGENT_MODEL_FALLBACKS="kimi-code/k3"
AGENT_TIMEOUT_SEC="280"

# Re-alert about an UNCHANGED failure set only after this many seconds (a
# changed failure alerts immediately). Keeps the 15-min timer from spamming.
ALERT_REPEAT_SEC="21600"

# Alert delivery. ALERT_TARGET defaults to MATRIX_ALERT_TARGET from
# ~/spark-recovery/matrix-target.env when unset here.
HERMES_BIN="hermes"
# ALERT_TARGET=""
