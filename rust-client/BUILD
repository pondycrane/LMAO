# ESP32 Rust LMAO client — Bazel mirror (design §5 / ticket T0).
#
# No rules_rust in this repo; the Rust host toolchain builds out-of-band (as
# does the native-client ESP-IDF firmware — same convention). This package
# keeps LMAO's Rust tree in the Bazel graph (filegroup) so everything native is
# Bazel-reachable, and wraps the fetch/build/gate flows as manual sh_binary
# targets so everything is driven from Bazel. All are `manual`: the T0 gate
# spawns a live Python RNS peer, and the Rust build shells out to `cargo`.
# Nothing here is pulled into `bazel test //tests:...`.
#
# The pinned RNS/LXMF protocol crates are NOT committed — WORKSPACE +
# repositories.bzl fetch them from crates.io by SHA-256 (see UPSTREAM.md), and
# `@rns_core//:sources` & co. expose the extracted trees in the graph, the same
# role the removed `vendor/` mirror used to play.
#
#   bazel build  //rust-client:build                        # cargo build (all)
#   bazel run    //rust-client:run_t0_gate -- --python <py> # T0 DECISION GATE
#   bazel build  //rust-client:rust_sources                 # source tree in graph
#
# Stable MicroPython revert (hardware, later): the Rust firmware is flashed to
# the Cardputer only from T1+; restoring the old MicroPython urns path is the
# existing canonical `bazel run //cardputer_client:flash` (raw REPL, re-injects
# the server DEST_HASH) — see UPSTREAM.md / T0-GATE.md.

filegroup(
    name = "rust_sources",
    srcs = glob(["**"], exclude = ["target/**"]) + [
        "@rns_core//:sources",
        "@rns_crypto//:sources",
        "@rns_net//:sources",
        "@lxmf_core//:sources",
        "@lxmf//:sources",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "build",
    srcs = ["build.sh"],
    data = [":rust_sources"],
    tags = ["manual"],
)

sh_binary(
    name = "run_t0_gate",
    srcs = ["run_t0_gate.sh"],
    data = [":rust_sources"],
    tags = ["manual"],
)

# ── T2 identity crate (leaf-rns) ────────────────────────────────────
# Host-testable core: mint/load RNS Identity + lxmf/delivery DEST + persistence
# trait (NVS backend plugs in on the firmware side). Pinned RNS crates come
# from repositories.bzl; `cargo test -p lma-identity` cross-checks the delivery
# DEST against Python RNS 1.3.5 goldens (see crates/lma-identity/tests).

filegroup(
    name = "identity_sources",
    srcs = glob(
        ["crates/lma-identity/**"],
        exclude = ["crates/**/target/**"],
    ) + [
        "@rns_core//:sources",
        "@rns_crypto//:sources",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_lma_identity",
    srcs = ["test_identity.sh"],
    data = [":identity_sources"],
    tags = ["manual"],
)

# ── T4 leaf-rns crate (duty-cycle link-window scheduling) ──────────
# Resolves design §11 #1 (how a duty-cycled leaf holds a Link): scheduled
# gateway->leaf link windows + a resume queue; the link is held across dormant
# gaps (sustain) rather than torn down. Host-testable scheduler.

filegroup(
    name = "leaf_rns_sources",
    srcs = glob(
        ["crates/leaf-rns/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_leaf_rns",
    srcs = ["test_leaf_rns.sh"],
    data = [":leaf_rns_sources"],
    tags = ["manual"],
)

# ── T3 radio interface crate (frame demux / RF-framing) ────────────
# Host-testable RNode LoRa RF framing port (lma_rnode_framing) + fixed SX1262
# RF params. On-device SX1262 SPI loopback is the T3 hardware leg (manual).

filegroup(
    name = "radio_sources",
    srcs = glob(
        ["crates/radio-interface/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_radio",
    srcs = ["test_radio.sh"],
    data = [":radio_sources"],
    tags = ["manual"],
)

# ── T5 lma-wire crate (prost LMAOEnvelope/SensorReport from the shared .proto) ─
# Generated by prost-build from proto/lma_messages.proto at build time (design
# §6b DRY). Cross-language equivalence vs the Python lma_encoder is locked by
# golden vectors (crates/lma-wire/tests). Needs protoc at build time (PROTOC).

filegroup(
    name = "lma_wire_sources",
    srcs = glob(
        ["crates/lma-wire/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_lma_wire",
    srcs = ["test_lma_wire.sh"],
    data = [":lma_wire_sources"],
    tags = ["manual"],
)

# ── T5 lma-lxmf crate (LXMF control path: pack/verify a protobuf envelope) ────
# Packs a prost LmaoEnvelope into a signed LXMF message addressed to the
# lxmf/delivery DEST; unpacks + verifies. Host round-trip + tamper tests in
# crates/lma-lxmf/tests. Builds on lma-wire (needs PROTOC).

filegroup(
    name = "lma_lxmf_sources",
    srcs = glob(
        ["crates/lma-lxmf/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_lma_lxmf",
    srcs = ["test_lma_lxmf.sh"],
    data = [":lma_lxmf_sources"],
    tags = ["manual"],
)

# ── L1 leaf-lxmf crate (LXMF opportunistic wire format) ────────────────
# The pure, host-testable LXMF wire logic extracted from firmware/src/rns_link.rs:
# RNS announce build, opportunistic pack/encrypt (encrypt `packed[16..]` — the
# L1 fix), the text-envelope protobuf, and the server-reply mirror decode.
# Builds directly on rns-core/lxmf-core/rns-crypto (no prost → no PROTOC).

filegroup(
    name = "leaf_lxmf_sources",
    srcs = glob(
        ["crates/leaf-lxmf/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_leaf_lxmf",
    srcs = ["test_leaf_lxmf.sh"],
    data = [":leaf_lxmf_sources"],
    tags = ["manual"],
)

# ── T6 leaf-resource crate (RNS Resource over Link on the leaf) ──────────────
# Wraps rns-core's ResourceReceiver/Sender for the leaf: RX (advertisement →
# parts → hash-verified assemble → completion proof), TX (leaf-originated),
# a Store seam (flash persistence boundary), and resume across a dormant link
# window (T4 sustain). Host tests cross-verify resource/map hashes against the
# Python RNS 1.3.5 server goldens (design §6b).

filegroup(
    name = "leaf_resource_sources",
    srcs = glob(
        ["crates/leaf-resource/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_leaf_resource",
    srcs = ["test_leaf_resource.sh"],
    data = [":leaf_resource_sources"],
    tags = ["manual"],
)

# ── T8 lma-framing crate (LMAF/successor framing on the Resource substrate) ──
# Receiver-side reassembler over the shared proto's LmafManifest/Chunk/Ack
# (prost-generated in lma-wire): CRC-32 per chunk + whole-payload SHA-256 verify,
# NEED/COMPLETE ack, carried by an RNS Resource. The framing wire itself lives in
# proto/lma_messages.proto (design §6c) and is vector-tested against the native
# C++ lma_attachment encoding in lma-wire's tests.

filegroup(
    name = "lma_framing_sources",
    srcs = glob(
        ["crates/lma-framing/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_lma_framing",
    srcs = ["test_lma_framing.sh"],
    data = [":lma_framing_sources"],
    tags = ["manual"],
)

# ── T9 leaf-power crate (power/duty-cycle polish) ───────────────────────────
# Deep-sleep scheduling between link windows (composed with the leaf-rns
# scheduler), a watchdog (detect a wedged/beaconing device — cf cardputer_client
# #74), and a heap-fragmentation guard (cf #71/#74 robustness). RSSI reporting
# is the lma-wire sensor_id 9 helper + golden (T9).

filegroup(
    name = "leaf_power_sources",
    srcs = glob(
        ["crates/leaf-power/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_leaf_power",
    srcs = ["test_leaf_power.sh"],
    data = [":leaf_power_sources"],
    tags = ["manual"],
)

# ── RF-leg: sx126x driver core (no_std, bus-generic) ─────────────────────────
# Port of the repo's MicroPython SX1262 driver (the one that RF-works on this
# Cardputer): opcodes/registers + the config calculations, host-golden-tested
# via a recording RadioBus. The esp-hal SPI binding + on-air RF TX/RX is the
# hardware leg. Bus-generic so the driver core is fully host-testable.

filegroup(
    name = "sx126x_sources",
    srcs = glob(
        ["crates/sx126x/**"],
        exclude = ["crates/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "test_sx126x",
    srcs = ["test_sx126x.sh"],
    data = [":sx126x_sources"],
    tags = ["manual"],
)

# ── T7 host E2E — the composed leaf pipeline (design §5 data-flow, minus RF) ──
# Runs the whole leaf on the host: identity + LXMF SensorReport control path
# (lma-identity/lma-wire/lma-lxmf) + an RNS Resource over the held link paced
# by link windows (leaf-rns) and reassembled hash-verified (leaf-resource).
# The RF leg (radio-interface over a real RNode) is the on-device T7 half.

sh_binary(
    name = "run_leaf_e2e",
    srcs = ["run_leaf_e2e.sh"],
    data = [":rust_sources"],
    tags = ["manual"],
)

# ── T1 firmware (ESP32-S3 / Cardputer, no_std esp-hal) ────────────────
# Builds out-of-band via cargo + the esp nightly toolchain (no rules_rust, and
# the xtensa target is outside Bazel) — same convention as native-client.
# `flash_firmware` REPLACES the Cardputer runtime (hardware; restore MicroPython
# with `bazel run //cardputer_client:flash`). Never pulled into test runs.

filegroup(
    name = "vendor_sources",
    srcs = glob(["vendor/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "firmware_sources",
    srcs = glob(
        ["firmware/**"],
        exclude = ["firmware/target/**"],
    ) + [":vendor_sources"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "build_firmware",
    srcs = ["build_firmware.sh"],
    data = [":firmware_sources"],
    tags = ["manual"],
)

sh_binary(
    name = "flash_firmware",
    srcs = ["flash_firmware.sh"],
    data = [":firmware_sources"],
    tags = ["manual"],
)
